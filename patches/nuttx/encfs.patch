+  g_rewind_error = -EIO;
+  position = dir_seek(&g_file, 1, SEEK_SET);
+  CHECK("backward rewind error preserves positions and skips no entries",
+        position == -EIO && g_file.f_pos == 2 && g_physical == 2 &&
