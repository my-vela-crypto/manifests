+        count == sizeof(entry) && g_file.f_pos == 1 && g_physical == 1);
+  count = dir_read(&g_file, (char *)&entry, sizeof(entry));
+  CHECK("second valid entry advances logical position",
+        count == sizeof(entry) && g_file.f_pos == 2 && g_physical == 2);
+  count = dir_read(&g_file, (char *)&entry, sizeof(entry));
