+                    FAR uint8_t *sealed);
+int aes_siv_decrypt(FAR const uint8_t key[AES_SIV_KEY_SIZE],
+                    FAR const uint8_t *ad, size_t adlen,
+                    FAR const uint8_t *sealed, size_t sealedlen,
+                    FAR uint8_t *plain);
+
+#ifdef __cplusplus
+}
+#endif
