+      memcpy(&dev->key2, &keys[1], sizeof(dev->key2));
+      dev->key_set = true;
+    }
+
+  explicit_bzero(keys, 2 * sizeof(*keys));
+  kmm_free(keys);
+  return ret;
 }
 
