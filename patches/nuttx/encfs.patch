diff --git a/fs/encfs/encfs_key.c b/fs/encfs/encfs_key.c
new file mode 100644
index 0000000000..1aacaca00a
--- /dev/null
+++ b/fs/encfs/encfs_key.c
@@ -0,0 +1,134 @@
+/****************************************************************************
+ * fs/encfs/encfs_key.c
+ *
+ * SPDX-License-Identifier: Apache-2.0
+ *
+ ****************************************************************************/
+
+/****************************************************************************
+ * Included Files
+ ****************************************************************************/
+
+#include <nuttx/config.h>
+
+#include <errno.h>
+#include <string.h>
+
+#include <nuttx/board.h>
+#include <nuttx/crypto/hkdf.h>
+
+#include "encfs.h"
+
+#if CONFIG_BOARDCTL_UNIQUEKEY_SIZE != ENCFS_MASTER_KEY_SIZE
+#  error "ENCFSMGR requires a 32-byte board unique key"
+#endif
+
+/****************************************************************************
+ * Private Data
+ ****************************************************************************/
+
+#ifdef CONFIG_ENCFS_TESTING
+static uint8_t g_test_master[ENCFS_MASTER_KEY_SIZE];
+static bool g_test_provider;
+static bool g_test_missing;
+#endif
+
+/****************************************************************************
+ * Public Functions
+ ****************************************************************************/
+
+/* A volatile store prevents dead-store elimination of temporary secrets. */
+
+void encfs_erase(FAR void *memory, size_t length)
+{
+  FAR volatile uint8_t *p = memory;
+
+  while (length-- > 0)
+    {
+      *p++ = 0;
+    }
+}
+
+static int encfs_read_master(FAR uint8_t *master)
+{
+#ifdef CONFIG_ENCFS_TESTING
+  if (g_test_provider)
+    {
+      if (g_test_missing)
+        {
+          return -ENOKEY;
+        }
+
+      memcpy(master, g_test_master, ENCFS_MASTER_KEY_SIZE);
+      return 0;
+    }
+#endif
+
+  return board_uniquekey(master);
+}
+
+int encfs_derive_keys(FAR struct encfs_keys_s *keys,
+                      FAR enum encfs_stage_e *stage)
+{
+  static const uint8_t blocksalt[] = "blkcrypt";
+  static const uint8_t pathsalt[] = "encpathfs";
+  uint8_t master[ENCFS_MASTER_KEY_SIZE];
+  int ret;
+
+  memset(keys, 0, sizeof(*keys));
+  *stage = ENCFS_STAGE_MASTER;
+  ret = encfs_read_master(master);
+  if (ret < 0)
+    {
+      goto out;
+    }
+
+  *stage = ENCFS_STAGE_DERIVE;
+  ret = hkdf_sha256(master, sizeof(master), blocksalt,
+                    sizeof(blocksalt) - 1, NULL, 0,
+                    keys->block, sizeof(keys->block));
+  if (ret < 0)
+    {
+      goto out;
+    }
+
+  ret = hkdf_sha256(master, sizeof(master), pathsalt,
+                    sizeof(pathsalt) - 1, NULL, 0,
+                    keys->path, sizeof(keys->path));
+out:
+  encfs_erase(master, sizeof(master));
+  if (ret < 0)
+    {
+      encfs_erase(keys, sizeof(*keys));
+    }
+
+  return ret;
+}
+
+#ifdef CONFIG_ENCFS_TESTING
+int encfs_key_set_test_master(FAR const uint8_t *key, size_t keylen)
+{
+  if ((key == NULL && keylen != 0) ||
+      (key != NULL && keylen != ENCFS_MASTER_KEY_SIZE))
+    {
+      return -EINVAL;
+    }
+
+  encfs_erase(g_test_master, sizeof(g_test_master));
+  g_test_provider = true;
+  g_test_missing = key == NULL;
+  if (key != NULL)
+    {
+      memcpy(g_test_master, key, sizeof(g_test_master));
+    }
+
+  return 0;
+}
+
+void encfs_key_use_board(void)
+{
+  encfs_erase(g_test_master, sizeof(g_test_master));
+  g_test_provider = false;
+  g_test_missing = false;
+}
+#endif
diff --git a/fs/encfs/encfs_manager.c b/fs/encfs/encfs_manager.c
new file mode 100644
index 0000000000..b5e4167bcc
--- /dev/null
+++ b/fs/encfs/encfs_manager.c
@@ -0,0 +1,735 @@
+/****************************************************************************
+ * fs/encfs/encfs_manager.c
+ *
+ * SPDX-License-Identifier: Apache-2.0
+ *
+ ****************************************************************************/
+
+/****************************************************************************
+ * Included Files
+ ****************************************************************************/
+
+#include <nuttx/config.h>
+
+#include <sys/stat.h>
+#include <assert.h>
+#include <errno.h>
+#include <string.h>
+
+#include <nuttx/fs/encpathfs.h>
+#include <nuttx/fs/fs.h>
+#include <nuttx/mutex.h>
+
+#include "inode/inode.h"
+#include "encfs.h"
+
+/****************************************************************************
+ * Private Data
+ ****************************************************************************/
+
+static mutex_t g_lock = NXMUTEX_INITIALIZER;
+static struct encfs_status_s g_status;
+
+/* Remember identities, without retaining a reference that would prevent an
+ * ordinary umount.  The inode serial also distinguishes a new mount whose
+ * allocation reuses the old inode/private-data addresses.
+ */
+
+struct encfs_mount_s
+{
+  ino_t ino;
+  FAR const struct mountpt_operations *ops;
+  FAR void *handle;
+};
+
+static struct encfs_mount_s g_upper;
+static struct encfs_mount_s g_lower;
+
+#ifdef CONFIG_ENCFS_TESTING
+static enum encfs_test_failpoint_e g_failpoint;
+#endif
+
+/****************************************************************************
+ * Private Functions
+ ****************************************************************************/
+
+/* All state and test-provider access is serialized by g_lock.
+ * No key material is stored in status or in the mount option string.
+ */
+
+static bool encfs_has_resources(void)
+{
+  return g_status.block_registered || g_status.lower_visible ||
+         g_status.upper_mounted || g_status.path_key_staged;
+}
+
+static void encfs_update_state(void)
+{
+  if (g_status.upper_mounted)
+    {
+      g_status.state = ENCFS_READY;
+    }
+  else if (g_status.lower_visible)
+    {
+      g_status.state = ENCFS_LOWER_MOUNTED;
+    }
+  else if (g_status.block_keyed)
+    {
+      g_status.state = ENCFS_BLOCK_KEYED;
+    }
+  else if (g_status.block_registered)
+    {
+      g_status.state = ENCFS_BLOCK_REGISTERED;
+    }
+  else
+    {
+      g_status.state = ENCFS_STOPPED;
+    }
+}
+
+static void encfs_clear_error(void)
+{
+  g_status.error = 0;
+  g_status.stage = ENCFS_STAGE_NONE;
+  g_status.cleanup_error = 0;
+  g_status.cleanup_stage = ENCFS_STAGE_NONE;
+}
+
+/* Call with the inode tree locked.  A path may have disappeared, become a
+ * pseudo directory, or been reused by an unrelated mount since the last
+ * manager operation.  Never claim or unmount that replacement.
+ */
+
+static int encfs_mount_present(FAR const char *path,
+                               FAR struct encfs_mount_s *identity)
+{
+  struct inode_search_s desc;
+  FAR struct inode *inode;
+  int ret;
+
+  SETUP_SEARCH(&desc, path, true);
+  ret = inode_search(&desc);
+  if (ret >= 0)
+    {
+      inode = desc.node;
+      ret = INODE_IS_MOUNTPT(inode) && desc.relpath[0] == '\0' &&
+            inode->i_ino == identity->ino &&
+            inode->u.i_mops == identity->ops &&
+            inode->i_private == identity->handle;
+    }
+  else if (ret == -ENOENT)
+    {
+      ret = 0;
+    }
+
+  RELEASE_SEARCH(&desc);
+  return ret;
+}
+
+static int encfs_refresh_mounts(void)
+{
+  int ret;
+
+  if (g_status.upper_mounted)
+    {
+      ret = encfs_mount_present(ENCFS_UPPER_PATH, &g_upper);
+      if (ret < 0)
+        {
+          return ret;
+        }
+
+      if (ret == 0)
+        {
+          /* Successful encpathfs unbind also released its hidden lower. */
+
+          g_status.upper_mounted = false;
+          g_status.lower_visible = false;
+          memset(&g_upper, 0, sizeof(g_upper));
+          memset(&g_lower, 0, sizeof(g_lower));
+        }
+    }
+
+  if (g_status.lower_visible)
+    {
+      ret = encfs_mount_present(ENCFS_LOWER_PATH, &g_lower);
+      if (ret < 0)
+        {
+          return ret;
+        }
+
+      if (ret == 0)
+        {
+          g_status.lower_visible = false;
+          memset(&g_lower, 0, sizeof(g_lower));
+        }
+    }
+
+  encfs_update_state();
+  return 0;
+}
+
+/* Keep publication and identity capture atomic with respect to an external
+ * umount/mount.  Refuse aliases and occupied targets.  After nx_mount has
+ * succeeded under the tree lock, lookup cannot lose the published inode.
+ */
+
+static int encfs_mount(FAR const char *source, FAR const char *target,
+                       FAR const char *filesystem, FAR const void *data,
+                       FAR struct encfs_mount_s *identity)
+{
+  struct inode_search_s desc;
+  int ret;
+
+  inode_lock();
+  SETUP_SEARCH(&desc, target, true);
+  ret = inode_search(&desc);
+  if (ret >= 0)
+    {
+      ret = INODE_IS_PSEUDODIR(desc.node) && desc.relpath[0] == '\0' ?
+            0 : -EBUSY;
+    }
+  else if (ret == -ENOENT)
+    {
+      ret = 0;
+    }
+
+  RELEASE_SEARCH(&desc);
+  if (ret >= 0)
+    {
+      ret = nx_mount(source, target, filesystem, 0, data);
+    }
+
+  if (ret >= 0)
+    {
+      SETUP_SEARCH(&desc, target, true);
+      ret = inode_search(&desc);
+      DEBUGASSERT(ret >= 0 && INODE_IS_MOUNTPT(desc.node) &&
+                  desc.relpath[0] == '\0');
+      if (ret >= 0)
+        {
+          identity->ino = desc.node->i_ino;
+          identity->ops = desc.node->u.i_mops;
+          identity->handle = desc.node->i_private;
+        }
+
+      RELEASE_SEARCH(&desc);
+    }
+
+  inode_unlock();
+  return ret;
+}
+
+/* Reserve the upper pseudo directory before bind can take ownership of the
+ * lower mount.  With an existing target, nx_mount has no allocating/failing
+ * publication step after bind.  This avoids a VFS error path that ignores an
+ * unbind error and would otherwise strand an invisible lower mount.
+ */
+
+static int encfs_prepare_upper(void)
+{
+  struct inode_search_s desc;
+  FAR struct inode *inode;
+  int ret;
+
+  SETUP_SEARCH(&desc, ENCFS_UPPER_PATH, true);
+  inode_lock();
+  ret = inode_find(&desc);
+  if (ret >= 0)
+    {
+      ret = INODE_IS_PSEUDODIR(desc.node) && desc.relpath[0] == '\0' ?
+            0 : -EBUSY;
+      inode_release(desc.node);
+    }
+  else if (ret == -ENOENT)
+    {
+      ret = inode_reserve_path(ENCFS_UPPER_PATH, 0777, &inode);
+    }
+
+  inode_unlock();
+  RELEASE_SEARCH(&desc);
+  return ret;
+}
+
+static int encfs_inject(enum encfs_stage_e stage)
+{
+#ifdef CONFIG_ENCFS_TESTING
+  enum encfs_test_failpoint_e point = ENCFS_TEST_FAIL_NONE;
+
+  switch (stage)
+    {
+      case ENCFS_STAGE_REGISTER:
+        point = ENCFS_TEST_FAIL_REGISTER;
+        break;
+      case ENCFS_STAGE_BLOCK_KEY:
+        point = ENCFS_TEST_FAIL_KEY;
+        break;
+      case ENCFS_STAGE_LOWER_MOUNT:
+      case ENCFS_STAGE_FORMAT:
+        point = ENCFS_TEST_FAIL_LOWER;
+        break;
+      case ENCFS_STAGE_UPPER_MOUNT:
+        point = ENCFS_TEST_FAIL_UPPER;
+        break;
+      default:
+        break;
+    }
+
+  if (point != ENCFS_TEST_FAIL_NONE && g_failpoint == point)
+    {
+      g_failpoint = ENCFS_TEST_FAIL_NONE;
+      return -EIO;
+    }
+#else
+  (void)stage;
+#endif
+
+  return 0;
+}
+
+static int encfs_release_error(enum encfs_stage_e stage, int ret,
+                                bool rollback)
+{
+  if (rollback)
+    {
+      g_status.cleanup_stage = stage;
+      g_status.cleanup_error = ret;
+    }
+  else
+    {
+      g_status.stage = stage;
+      g_status.error = ret;
+    }
+
+  encfs_update_state();
+  return ret;
+}
+
+/* Release strictly in reverse ownership order.  A failed unmount must leave
+ * its dependent resources alive.  In particular, -EBUSY at /data preserves
+ * the complete running chain and the caller may retry after closing handles.
+ */
+
+static int encfs_release_locked(bool rollback)
+{
+  int ret;
+
+  ret = encfs_refresh_mounts();
+  if (ret < 0)
+    {
+      return encfs_release_error(ENCFS_STAGE_UPPER_UMOUNT, ret, rollback);
+    }
+
+  if (g_status.upper_mounted)
+    {
+      ret = nx_umount2(ENCFS_UPPER_PATH, 0);
+      if (ret < 0)
+        {
+          return encfs_release_error(ENCFS_STAGE_UPPER_UMOUNT, ret,
+                                     rollback);
+        }
+
+      /* encpathfs unbind also closes and releases the hidden FatFs mount. */
+
+      g_status.upper_mounted = false;
+      g_status.lower_visible = false;
+      memset(&g_upper, 0, sizeof(g_upper));
+      memset(&g_lower, 0, sizeof(g_lower));
+    }
+
+  if (g_status.lower_visible)
+    {
+      /* A failed metadata close may still own a temporary lower file.
+       * Retry it before releasing the key slot or unmounting its lower.
+       */
+
+      ret = encpathfs_recover();
+      if (ret < 0)
+        {
+          return encfs_release_error(ENCFS_STAGE_LOWER_UMOUNT, ret,
+                                     rollback);
+        }
+    }
+
+  if (g_status.path_key_staged)
+    {
+      ret = encpathfs_clearkey(ENCFS_KEY_SLOT);
+      if (ret < 0)
+        {
+          return encfs_release_error(ENCFS_STAGE_PATH_KEY, ret, rollback);
+        }
+
+      g_status.path_key_staged = false;
+    }
+
+  if (g_status.lower_visible)
+    {
+      ret = nx_umount2(ENCFS_LOWER_PATH, 0);
+      if (ret < 0)
+        {
+          return encfs_release_error(ENCFS_STAGE_LOWER_UMOUNT, ret,
+                                     rollback);
+        }
+
+      g_status.lower_visible = false;
+      memset(&g_lower, 0, sizeof(g_lower));
+    }
+
+  if (g_status.block_registered)
+    {
+      ret = encfs_block_unregister();
+      if (ret < 0)
+        {
+          return encfs_release_error(ENCFS_STAGE_UNREGISTER, ret, rollback);
+        }
+
+      g_status.block_registered = false;
+      g_status.block_keyed = false;
+    }
+
+  encfs_update_state();
+  return 0;
+}
+
+static int encfs_release(bool rollback)
+{
+  int ret;
+
+  /* Serialize the identity check and unmount itself.  Checking first and
+   * unlocking would allow another task to replace the mount in between.
+   */
+
+  inode_lock();
+  ret = encfs_release_locked(rollback);
+  inode_unlock();
+  return ret;
+}
+
+/* Start and provision share block/key acquisition, but only provision passes
+ * forceformat.  Plain start must never pass autoformat or create metadata.
+ */
+
+static int encfs_acquire(bool provision)
+{
+  struct encfs_keys_s keys;
+  int clearret;
+  int ret;
+
+  encfs_clear_error();
+  if (!provision)
+    {
+      g_status.stage = ENCFS_STAGE_PREPARE_UPPER;
+      ret = encfs_prepare_upper();
+      if (ret < 0)
+        {
+          goto fail;
+        }
+    }
+
+  g_status.stage = ENCFS_STAGE_REGISTER;
+  ret = encfs_inject(g_status.stage);
+  if (ret < 0)
+    {
+      goto fail;
+    }
+
+  ret = encfs_block_register();
+  if (ret < 0)
+    {
+      goto fail;
+    }
+
+  g_status.block_registered = true;
+  ret = encfs_derive_keys(&keys, &g_status.stage);
+  if (ret < 0)
+    {
+      goto fail;
+    }
+
+  g_status.stage = ENCFS_STAGE_BLOCK_KEY;
+  ret = encfs_inject(g_status.stage);
+  if (ret < 0)
+    {
+      goto fail;
+    }
+
+  ret = encfs_block_set_key(keys.block);
+  encfs_erase(keys.block, sizeof(keys.block));
+  if (ret < 0)
+    {
+      goto fail;
+    }
+
+  g_status.block_keyed = true;
+  g_status.stage = provision ? ENCFS_STAGE_FORMAT : ENCFS_STAGE_LOWER_MOUNT;
+  ret = encfs_inject(g_status.stage);
+  if (ret < 0)
+    {
+      goto fail;
+    }
+
+  ret = encfs_mount(ENCFS_BLOCK_DEVICE, ENCFS_LOWER_PATH, "fatfs",
+                    provision ? "forceformat" : NULL, &g_lower);
+  if (ret < 0)
+    {
+      goto fail;
+    }
+
+  g_status.lower_visible = true;
+  if (provision)
+    {
+      g_status.stage = ENCFS_STAGE_INITIALIZE;
+      ret = encpathfs_initialize(ENCFS_LOWER_PATH, keys.path,
+                                sizeof(keys.path));
+      encfs_erase(&keys, sizeof(keys));
+      if (ret < 0)
+        {
+          goto fail;
+        }
+
+      encfs_clear_error();
+      return encfs_release(false);
+    }
+
+  g_status.stage = ENCFS_STAGE_PATH_KEY;
+  ret = encpathfs_setkey(ENCFS_KEY_SLOT, keys.path, sizeof(keys.path));
+  encfs_erase(&keys, sizeof(keys));
+  if (ret < 0)
+    {
+      goto fail;
+    }
+
+  g_status.path_key_staged = true;
+  g_status.stage = ENCFS_STAGE_UPPER_MOUNT;
+  ret = encfs_inject(g_status.stage);
+  if (ret < 0)
+    {
+      goto fail;
+    }
+
+  ret = encfs_mount(NULL, ENCFS_UPPER_PATH, "encpathfs",
+                    "lower=" ENCFS_LOWER_PATH ",root=.p,slot=0", &g_upper);
+  if (ret >= 0)
+    {
+      g_status.upper_mounted = true;
+      g_status.lower_visible = false;
+      memset(&g_lower, 0, sizeof(g_lower));
+    }
+  else
+    {
+      /* bind consumes the lower mount on success; VFS also invokes unbind
+       * if publishing /data subsequently fails.  In that case /datap has
+       * disappeared and its resources have already been released.  Earlier
+       * bind failures leave /datap visible for our rollback.
+       */
+
+      inode_lock();
+      encfs_refresh_mounts();
+      inode_unlock();
+    }
+
+  /* bind consumes its key slot on all paths.  A failure before bind (e.g. an
+   * existing /data mount) does not, so explicitly clear that case as well.
+   * A successful mount returns -EBUSY here because its key context is
+   * active;
+   * the temporary slot has nevertheless been erased by bind.
+   */
+
+  clearret = encpathfs_clearkey(ENCFS_KEY_SLOT);
+  if (clearret >= 0 || (clearret == -EBUSY && g_status.upper_mounted))
+    {
+      g_status.path_key_staged = false;
+    }
+
+  if (ret < 0)
+    {
+      goto fail;
+    }
+
+  if (clearret < 0 && g_status.path_key_staged)
+    {
+      g_status.stage = ENCFS_STAGE_PATH_KEY;
+      ret = clearret;
+      goto fail;
+    }
+
+  encfs_clear_error();
+  encfs_update_state();
+  return 0;
+
+fail:
+  encfs_erase(&keys, sizeof(keys));
+  g_status.error = ret;
+  encfs_release(true);
+  return ret;
+}
+
+/****************************************************************************
+ * Public Functions
+ ****************************************************************************/
+
+int encfs_start(void)
+{
+  int ret = nxmutex_lock(&g_lock);
+
+  if (ret < 0)
+    {
+      return ret;
+    }
+
+  inode_lock();
+  ret = encfs_refresh_mounts();
+  if (ret >= 0)
+    {
+      if (g_status.upper_mounted)
+        {
+          ret = 0;
+        }
+      else if (encfs_has_resources())
+        {
+          ret = -EBUSY;
+        }
+      else
+        {
+          inode_unlock();
+          ret = encfs_acquire(false);
+          nxmutex_unlock(&g_lock);
+          return ret;
+        }
+    }
+
+  inode_unlock();
+  nxmutex_unlock(&g_lock);
+  return ret;
+}
+
+int encfs_stop(void)
+{
+  int ret = nxmutex_lock(&g_lock);
+
+  if (ret < 0)
+    {
+      return ret;
+    }
+
+  encfs_clear_error();
+  ret = encfs_release(false);
+  nxmutex_unlock(&g_lock);
+  return ret;
+}
+
+int encfs_provision(void)
+{
+  int ret = nxmutex_lock(&g_lock);
+
+  if (ret < 0)
+    {
+      return ret;
+    }
+
+  inode_lock();
+  ret = encfs_refresh_mounts();
+  inode_unlock();
+  if (ret >= 0)
+    {
+      ret = encfs_has_resources() ? -EBUSY : encfs_acquire(true);
+    }
+
+  nxmutex_unlock(&g_lock);
+  return ret;
+}
+
+int encfs_get_status(FAR struct encfs_status_s *status)
+{
+  int ret;
+
+  if (status == NULL)
+    {
+      return -EINVAL;
+    }
+
+  ret = nxmutex_lock(&g_lock);
+  if (ret < 0)
+    {
+      return ret;
+    }
+
+  inode_lock();
+  ret = encfs_refresh_mounts();
+  if (ret >= 0)
+    {
+      *status = g_status;
+    }
+
+  inode_unlock();
+  nxmutex_unlock(&g_lock);
+  return ret;
+}
+
+#ifdef CONFIG_ENCFS_TESTING
+int encfs_test_set_master(FAR const uint8_t *key, size_t keylen)
+{
+  int ret = nxmutex_lock(&g_lock);
+
+  if (ret < 0)
+    {
+      return ret;
+    }
+
+  ret = encfs_has_resources() ? -EBUSY :
+        encfs_key_set_test_master(key, keylen);
+  nxmutex_unlock(&g_lock);
+  return ret;
+}
+
+int encfs_test_use_board_key(void)
+{
+  int ret = nxmutex_lock(&g_lock);
+
+  if (ret < 0)
+    {
+      return ret;
+    }
+
+  if (encfs_has_resources())
+    {
+      ret = -EBUSY;
+    }
+  else
+    {
+      encfs_key_use_board();
+      ret = 0;
+    }
+
+  nxmutex_unlock(&g_lock);
+  return ret;
+}
+
+int encfs_test_set_failpoint(enum encfs_test_failpoint_e failpoint)
+{
+  int ret;
+
+  if (failpoint < ENCFS_TEST_FAIL_NONE || failpoint > ENCFS_TEST_FAIL_UPPER)
+    {
+      return -EINVAL;
+    }
+
+  ret = nxmutex_lock(&g_lock);
+  if (ret < 0)
+    {
+      return ret;
+    }
+
+  if (encfs_has_resources())
+    {
+      ret = -EBUSY;
+    }
+  else
+    {
+      g_failpoint = failpoint;
+      ret = 0;
+    }
+
+  nxmutex_unlock(&g_lock);
+  return ret;
+}
+#endif
