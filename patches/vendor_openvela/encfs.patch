+# Encrypted volumes are explicitly provisioned inside the guest.  Never put
+# plaintext assets or a plaintext FAT filesystem in their initial data image.
+if(CONFIG_ENCFSMGR)
+  add_custom_target(
+    gen_images ALL
+    DEPENDS nuttx
+    COMMAND genromfs -f ${CMAKE_BINARY_DIR}/vela_system.bin -d ${NUTTX_BOARD_ABS_DIR}/prebuilts/system
+    COMMAND ${CMAKE_COMMAND} -E rm -f ${CMAKE_BINARY_DIR}/vela_data.bin
+    COMMAND truncate -s 256M ${CMAKE_BINARY_DIR}/vela_data.bin)
+else()
+  add_custom_target(
+    gen_images ALL
+    DEPENDS nuttx
+    COMMAND genromfs -f ${CMAKE_BINARY_DIR}/vela_system.bin -d ${NUTTX_BOARD_ABS_DIR}/prebuilts/system
