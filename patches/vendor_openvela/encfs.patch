index 0000000..f79bf0a
--- /dev/null
+++ b/boards/vela/prebuilts/tools/tests/test_run_emulator_portable.py
@@ -0,0 +1,152 @@
+#!/usr/bin/env python3
+"""Check launcher arguments using tiny fixtures, without starting an emulator."""
+
+import json
+import os
+from pathlib import Path
+import shutil
+import subprocess
+import tempfile
+import unittest
+
+
+SCRIPT = Path(__file__).resolve().parents[1] / "run_emulator.sh"
+
+
+class PortableLauncherTest(unittest.TestCase):
+    def setUp(self):
+        self.temporary = tempfile.TemporaryDirectory(prefix="vela launcher ")
+        self.addCleanup(self.temporary.cleanup)
+        self.root = Path(self.temporary.name) / "项目 workspace"
+        self.target = self.root / "vendor/openvela/boards/vela"
+        self.tools = self.target / "prebuilts/tools"
+        self.tools.mkdir(parents=True)
+        self.script = self.tools / "run_emulator.sh"
+        shutil.copyfile(SCRIPT, self.script)
+        (self.tools / "modem_simulator").write_bytes(b"modem fixture")
+        (self.root / "nuttx").mkdir()
+        (self.root / "nuttx/nuttx").write_bytes(b"ELF fixture")
+        (self.root / "nuttx/vela_data.bin").write_bytes(b"data fixture")
+        self.bin = self.root / "host tools"
+        self.bin.mkdir()
+        self.argv = self.root / "arguments.json"
+        self.file_args = self.root / "file-arguments.json"
+        self.emulator = self.bin / "stub emulator"
+        self.write_executable(self.emulator, """
+import json, os, sys
+from pathlib import Path
+Path(os.environ['ARGV_LOG']).write_text(json.dumps(sys.argv[1:]))
+sys.exit(int(os.environ.get('EMULATOR_STATUS', '0')))
+""")
+        self.write_executable(self.bin / "file", """
+import json, os, sys
+from pathlib import Path
+assert len(sys.argv) == 4 and sys.argv[1:3] == ['-bL', '--'], sys.argv
+assert Path(sys.argv[3]).is_file(), sys.argv
+Path(os.environ['FILE_LOG']).write_text(json.dumps(sys.argv[1:]))
+print(os.environ.get('FILE_FORMAT', 'ELF 64-bit LSB executable, ARM aarch64'))
+""")
+        self.write_executable(self.bin / "dd", """
+import sys
+from pathlib import Path
+assert len(sys.argv) == 5, sys.argv
+assert sys.argv[1] == 'if=/dev/zero', sys.argv
+assert sys.argv[3:] == ['bs=200M', 'count=1'], sys.argv
+assert sys.argv[2].startswith('of='), sys.argv
+Path(sys.argv[2][3:]).write_bytes(b'core fixture')
+""")
+        self.home = self.root / "home 中文"
+        self.avd_home = self.root / "AVD registrations"
+        self.avd_space = self.root / "AVD images"
+        self.env = dict(os.environ, PATH=str(self.bin) + os.pathsep + os.environ["PATH"],
+                        TOP_DIR=str(self.root), TARGETDIR=str(self.target),
+                        EMULATOR_BIN=str(self.emulator), HOME=str(self.home),
+                        ANDROID_AVD_HOME=str(self.avd_home),
+                        CUSTOM_AVD_SPACE=str(self.avd_space), ARGV_LOG=str(self.argv),
+                        FILE_LOG=str(self.file_args))
+
+    @staticmethod
+    def write_executable(path, body):
+        path.write_text("#!/usr/bin/env python3\n" + body)
+        path.chmod(0o755)
+
+    def run_launcher(self, *arguments, **env):
+        return subprocess.run(["bash", str(self.script), *arguments],
+                              cwd=self.root.parent, env=dict(self.env, **env),
+                              text=True, capture_output=True)
+
+    def test_aarch64_paths_options_and_registration(self):
+        name = "class_demo 中文"
+        share = self.root / "shared files 中文"
+        result = self.run_launcher("-keep", name, "-no-window", "-gpu",
+                                   "swiftshader_indirect", "-p", str(share))
+        self.assertEqual(result.returncode, 0, result.stdout + result.stderr)
+        args = json.loads(self.argv.read_text())
+        self.assertEqual(args[:8], ["-vela", "-avd", name, "-show-kernel",
+                                   "-no-window", "-gpu", "swiftshader_indirect", "-qemu"])
+        self.assertEqual(args.count("-qemu"), 1)
+        self.assertEqual(args.count("-no-window"), 1)
+        self.assertNotIn("-keep", args)
+        self.assertNotIn("-p", args)
+        avd = self.avd_space / (name + ".vvd")
+        self.assertIn("index=2,id=vendor,if=none,format=raw,file=" + str(avd / "coredump.core"), args)
+        self.assertIn("local,security_model=none,id=fsdev0,path=" + str(share), args)
+        self.assertTrue(share.is_dir())
+        registration = "path=" + str(avd) + "\n"
+        self.assertEqual((self.avd_home / (name + ".ini")).read_text(), registration)
+        self.assertEqual((self.home / ".vela" / (name + ".ini")).read_text(), registration)
+        config = (avd / "config.ini").read_text()
+        self.assertIn("image.sysdir.1 = " + str(self.root / "nuttx"), config)
+        self.assertIn("skin.path = " + str(self.tools / "xiaomi_smart_screen_10"), config)
+        self.assertIn("avd.ini.displayname = class demo 中文", config)
+        self.assertEqual((avd / "vela_data.bin").read_bytes(), b"data fixture")
+        self.assertEqual((avd / "modem_simulator").read_bytes(), b"modem fixture")
+        self.assertEqual(json.loads(self.file_args.read_text()),
+                         ["-bL", "--", str(self.root / "nuttx/nuttx")])
+
+    def test_explicit_qemu_boundary_and_x86_defaults(self):
+        result = self.run_launcher("-keep", "x86", "-no-window", "-qemu", "-d",
+                                   "guest errors", FILE_FORMAT="ELF 64-bit LSB executable, x86-64")
+        self.assertEqual(result.returncode, 0, result.stderr)
+        args = json.loads(self.argv.read_text())
+        self.assertEqual(args[:8], ["-vela", "-avd", "x86", "-show-kernel",
+                                   "-no-window", "-qemu", "-d", "guest errors"])
+        self.assertEqual(args.count("-qemu"), 1)
+        self.assertIn("Skylake-Client,-hle,-rtm,-mpx", args)
+        self.assertIn("virtio-blk-pci,drive=vendor", args)
+        self.assertNotIn("virtio-blk-device,bus=virtio-mmio-bus.5,drive=vendor", args)
+
+    def test_existing_data_survives_and_core_is_backed_up(self):
+        result = self.run_launcher("-keep", "persistent")
+        self.assertEqual(result.returncode, 0, result.stderr)
+        avd = self.avd_space / "persistent.vvd"
+        (avd / "vela_data.bin").write_bytes(b"existing encrypted data")
+        (avd / "coredump.core").write_bytes(b"previous core")
+        result = self.run_launcher("-keep", "persistent")
+        self.assertEqual(result.returncode, 0, result.stderr)
+        self.assertEqual((avd / "vela_data.bin").read_bytes(), b"existing encrypted data")
+        backups = [path for path in avd.glob("*.core") if path.name != "coredump.core"]
+        self.assertEqual(len(backups), 1)
+        self.assertEqual(backups[0].read_bytes(), b"previous core")
+
+    def test_missing_keep_and_share_values_fail_before_launch(self):
+        for option in ("-keep", "-p"):
+            with self.subTest(option=option):
+                result = self.run_launcher(option)
+                self.assertNotEqual(result.returncode, 0)
+                self.assertIn("requires a value", result.stdout + result.stderr)
+                self.assertFalse(self.argv.exists())
+
+    def test_invalid_kernel_fails_before_launch(self):
+        result = self.run_launcher(FILE_FORMAT="ASCII text")
+        self.assertNotEqual(result.returncode, 0)
+        self.assertIn("Invalid NuttX binary", result.stdout)
+        self.assertFalse(self.argv.exists())
+
+    def test_emulator_exit_status_is_preserved(self):
+        result = self.run_launcher(EMULATOR_STATUS="37")
+        self.assertEqual(result.returncode, 37)
+
+
+if __name__ == "__main__":
+    unittest.main()
