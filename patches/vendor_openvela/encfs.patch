diff --git a/boards/vela/prebuilts/tools/run_emulator.sh b/boards/vela/prebuilts/tools/run_emulator.sh
index 498c5f2..fa7562e 100755
--- a/boards/vela/prebuilts/tools/run_emulator.sh
+++ b/boards/vela/prebuilts/tools/run_emulator.sh
@@ -33,7 +33,7 @@ fi
 
 # default variables
 
-AVD_HOME="${HOME}/.vela/vvd"
+AVD_HOME="${ANDROID_AVD_HOME:-${HOME}/.vela/vvd}"
 AVD_NAME="Vela_Generic_Device"
 AVD_DISPLAY_NAME=$(echo ${AVD_NAME} | tr '_' ' ')
 
@@ -89,13 +89,20 @@ HOST_9PFS_DIR=${HOST_9PFS_DIR:-"${AVD_PATH}/share"}
 AVD_INI="${AVD_HOME}/${AVD_NAME}.ini"
 AVD_CONFIG_INI="${AVD_PATH}/config.ini"
 
-mkdir -p ${AVD_PATH}
+mkdir -p "${AVD_HOME}" "${AVD_PATH}"
 
 cat << EOF > ${AVD_INI}
 path=${AVD_PATH}
-path.rel=avd/${AVD_PATH_REL}
 EOF
 
+# The bundled Vela emulator resolves VVD registrations directly in ~/.vela,
+# even when ANDROID_AVD_HOME or CUSTOM_AVD_SPACE selects an external data disk.
+# Publish only the selected instance's registration; its images stay in AVD_PATH.
+mkdir -p "${HOME}/.vela"
+if [[ "${AVD_INI}" != "${HOME}/.vela/${AVD_NAME}.ini" ]]; then
+  cp "${AVD_INI}" "${HOME}/.vela/${AVD_NAME}.ini"
+fi
+
 if [ -n "$(file -bL ${NUTTX_BIN} | grep 'ELF 64-bit LSB executable, ARM aarch64')" ]; then
   AVD_ABI="arm64-v8a"
   AVD_ARCH="arm64"
