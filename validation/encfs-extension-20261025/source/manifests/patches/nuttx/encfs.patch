+        exchange_cb = c.CFUNCTYPE(c.c_int, c.c_void_p, bytep, bytep)
+
+        class Provider(c.Structure):
+            _fields_ = [("context", c.c_void_p), ("master", master_cb),
+                        ("random", random_cb), ("read", read_cb),
+                        ("exchange", exchange_cb)]
+
+        masters = {0: os.urandom(32), 1: os.urandom(32)}
+        fixture = os.urandom(64)
+        store = {"slot": None, "master_error": 0, "random_error": 0,
+                 "read_error": 0, "exchange_error": 0, "random_calls": 0}
+
