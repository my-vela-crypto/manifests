+            key = masters.get(ident)
+            if key is None:
+                return -errno.ENOKEY
+            c.memmove(out, key, len(key))
+            return 0
+
+        @random_cb
+        def random(context, out, size):
+            store["random_calls"] += 1
+            c.memmove(out, fixture, min(size, len(fixture)))
+            return store["random_error"]
+
+        @read_cb
+        def read(context, out):
+            if store["read_error"]:
