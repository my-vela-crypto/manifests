+                return store["read_error"]
+            if store["slot"] is None:
+                return -errno.ENOENT
+            if len(store["slot"]) != 112:
+                return -errno.EBADMSG
+            c.memmove(out, store["slot"], 112)
+            return 0
+
+        @exchange_cb
+        def exchange(context, expected, next_slot):
+            if store["exchange_error"]:
+                return store["exchange_error"]
+            wanted = c.string_at(expected, 112) if expected else None
+            if wanted != store["slot"]:
+                return -errno.ESTALE
+            store["slot"] = c.string_at(next_slot, 112)
+            return 0
+
+        provider = Provider(None, get_master, random, read, exchange)
+        lib.encfs_key_set_provider.argtypes = (c.POINTER(Provider),)
+        lib.encfs_keys_acquire.argtypes = (c.c_bool, bytep, c.POINTER(c.c_int))
+        lib.encfs_keys_rekey.argtypes = (c.c_uint32,)
+        lib.test_generation_slot.argtypes = (bytep,)
+        lib.test_foreign_slot.argtypes = (bytep,)
+        lib.encfs_keys_staging_valid.argtypes = (bytep, c.c_size_t)
+        keys = (c.c_ubyte * 64)()
+        stage = c.c_int()
+
+        def acquire(provision=False):
+            c.memset(keys, 0x55, 64)
+            return lib.encfs_keys_acquire(provision, keys, c.byref(stage))
+
+        check(lib.encfs_key_set_provider(c.byref(provider)) == 0, "select provider")
+        check(acquire() == -errno.ENOKEY, "selected missing slot fails closed")
+        check(bytes(keys) == bytes(64), "missing slot clears output")
+        check(lib.test_board_calls() == 0, "missing slot never uses board fallback")
+        check(acquire(True) == 0, "provision prepares random DEKs")
+        check(bytes(keys) == fixture, "DEKs originate in provider entropy")
+        lib.hkdf_sha256.argtypes = (c.c_char_p, c.c_size_t, c.c_char_p,
+                                    c.c_size_t, c.c_void_p, c.c_size_t,
+                                    bytep, c.c_size_t)
+        directly_derived = bytearray()
+        for salt in (b"blkcrypt", b"encpathfs"):
+            part = (c.c_ubyte * 32)()
+            check(lib.hkdf_sha256(masters[0], 32, salt, len(salt), None, 0,
+                                  part, 32) == 0, "derive legacy comparison")
+            directly_derived.extend(part)
+        check(bytes(directly_derived) != fixture,
+              "old master cannot compute random DEKs using legacy KDF")
+        check(store["slot"] is None, "provision does not prematurely commit")
+        check(lib.encfs_keys_commit() == 0, "commit new slot")
+        initial = store["slot"]
+        check(initial[:8] == b"ENCKEY01" and len(initial) == 112, "slot format")
+        lib.encfs_keys_forget()
+        check(lib.test_cache_clean(), "forget erases all key and slot caches")
+        check(acquire() == 0 and bytes(keys) == fixture, "actual SIV unwrap")
+        check(store["random_calls"] == 1, "restart never regenerates keys")
+        check(lib.encfs_keys_rekey(0) == -errno.EALREADY,
+              "same master ID cannot falsely report rotation")
+
+        def staging(raw):
+            buffer = (c.c_ubyte * len(raw)).from_buffer_copy(raw)
+            return lib.encfs_keys_staging_valid(buffer, len(raw))
+
+        for length in range(113):
+            check(staging(initial[:length]) == 0,
+                  "recover own interrupted staging prefix length %d" % length)
+        check(staging(initial + b"x") == -errno.EBADMSG,
+              "reject oversized staging file")
+        for index in range(12):
+            for length in range(index + 1, 113):
+                corrupt = bytearray(initial[:length])
+                corrupt[index] ^= 0x80
+                check(staging(bytes(corrupt)) == -errno.EBADMSG,
+                      "reject corrupt staging magic/version %d:%d" % (index, length))
+        foreign = (c.c_ubyte * 112)()
+        check(lib.test_foreign_slot(foreign) == 0, "seal foreign-volume staging")
+        check(staging(bytes(foreign)) == -errno.ESTALE,
+              "never discard authenticated foreign-volume complete staging")
+        corrupt = bytearray(initial)
+        corrupt[-1] ^= 1
+        check(staging(bytes(corrupt)) == -errno.EBADMSG,
+              "complete staging requires SIV authentication")
+
+        # Every single-bit corruption, including header/master ID/generation,
+        # must be rejected, without board fallback or plaintext output.
+        for index in range(112):
+            for bit in range(8):
+                corrupt = bytearray(initial)
+                corrupt[index] ^= 1 << bit
+                store["slot"] = bytes(corrupt)
+                check(acquire() < 0, "reject mutated slot %d:%d" % (index, bit))
+                check(bytes(keys) == bytes(64) and lib.test_cache_clean(),
+                      "mutation clears output/cache %d:%d" % (index, bit))
+        check(lib.test_board_calls() == 0, "all mutations avoid legacy fallback")
+        store["slot"] = initial
+        old_key = masters.pop(0)
+        check(acquire() == -errno.ENOKEY and lib.test_cache_clean(),
+              "retired old master cannot open initial slot")
+        masters[0] = old_key
+
+        for field in ("master_error", "read_error"):
+            for error in (-errno.EIO, 1):
+                store[field] = error
+                check(acquire() == -errno.EIO, "normalize provider %s" % field)
+                check(bytes(keys) == bytes(64) and lib.test_cache_clean(),
+                      "erase partial provider %s result" % field)
+            store[field] = 0
+        for error in (-errno.EIO, 1):
+            store["random_error"] = error
+            check(acquire(True) == -errno.EIO, "random failure aborts provision")
+            check(bytes(keys) == bytes(64) and lib.test_cache_clean(),
+                  "erase partial random DEKs")
+            check(store["slot"] == initial, "random failure preserves slot")
+        store["random_error"] = 0
+        check(acquire() == 0, "reacquire before rekey failures")
+
+        stale = bytearray(initial)
+        stale[-1] ^= 1
+        store["slot"] = bytes(stale)
+        check(lib.encfs_keys_rekey(1) == -errno.ESTALE,
+              "CAS detects actual external slot modification")
+        check(store["slot"] == bytes(stale), "stale rekey never overwrites slot")
+        store["slot"] = initial
+
+        for error in (-errno.EIO, -errno.ESTALE, 1):
+            store["exchange_error"] = error
+            check(lib.encfs_keys_rekey(1) == (-errno.EIO if error > 0 else error),
+                  "surface CAS failure")
+            check(store["slot"] == initial, "failed rekey leaves old slot intact")
+        store["exchange_error"] = 0
+        newer_master = masters.pop(1)
+        check(lib.encfs_keys_rekey(1) == -errno.ENOKEY, "missing target master")
+        check(store["slot"] == initial, "missing target leaves old slot intact")
+        masters[1] = newer_master
+        check(lib.encfs_keys_rekey(1) == 0, "online rewrap succeeds")
+        rotated = store["slot"]
+        check(rotated != initial and int.from_bytes(rotated[12:16], "little") == 1
+              and int.from_bytes(rotated[16:24], "little") == 2,
+              "rewrap authenticates new ID and generation")
+        masters.pop(0)
+        check(acquire() == 0 and bytes(keys) == fixture,
+              "new master reopens identical DEKs after old-master removal")
+        masters[1] = old_key
+        check(acquire() == -errno.EBADMSG, "old master bytes cannot unwrap new slot")
+        check(bytes(keys) == bytes(64) and lib.test_cache_clean(),
+              "wrong master erases every temporary/cached key")
+        masters[1] = newer_master
+        check(acquire() == 0 and bytes(keys) == fixture, "restore current master")
+
+        # Actual authenticated UINT64_MAX record checks overflow, rather than
+        # relying on an unauthenticated generation edit rejected by SIV first.
+        masters[0] = old_key
+        overflow = (c.c_ubyte * 112)()
+        check(lib.test_generation_slot(overflow) == 0, "seal maximum generation")
+        store["slot"] = bytes(overflow)
+        check(acquire() == 0 and bytes(keys) == fixture, "open maximum generation")
+        check(lib.encfs_keys_rekey(1) == -errno.EOVERFLOW, "rekey rejects wraparound")
+        random_calls = store["random_calls"]
+        check(acquire(True) == -errno.EOVERFLOW, "provision rejects wraparound")
+        check(store["random_calls"] == random_calls, "overflow consumes no entropy")
+
+        # A saved old slot remains decryptable by its saved old master.  This
+        # intentionally records the documented lack of monotonic anti-rollback.
+        store["slot"] = initial
+        check(acquire() == 0 and bytes(keys) == fixture,
+              "saved old slot remains a documented rollback boundary")
+        lib.encfs_keys_forget()
+        check(lib.test_cache_clean(), "final cache erasure")
+        check(lib.encfs_key_set_provider(None) == 0, "select legacy mode")
+        check(acquire() == 0, "legacy acquisition remains supported")
+        check(bytes(keys) != fixture, "fresh DEKs differ from legacy-derived DEKs")
+        check(lib.encfs_keys_rekey(1) == -errno.ENOTSUP,
+              "legacy keys cannot claim revocation by rewrap")
+
+        check(all(hashlib.sha256((root / name).read_bytes()).hexdigest() == value
+                  for name, value in hashes.items()),
+              "all tested source/header bytes remain unchanged during run")
+
+        report = {"status": "passed", "checks": checks,
+                  "single_bit_slot_mutations": 112 * 8,
+                  "actual_sources": [str(path.relative_to(root))
+                                     for path in [root / "fs/encfs/encfs_keywrap.c",
+                                                  *sources[1:]]],
+                  "keywrap_sha256": hashlib.sha256(
+                      (root / "fs/encfs/encfs_keywrap.c").read_bytes()).hexdigest(),
+                  "source_sha256": hashes,
+                  "sanitizer": "undefined behavior; fatal on first diagnostic",
+                  "limits": ["provider atomicity is modeled, not physical media",
+                             "saved old slot and old master allow rollback",
+                             "manager concurrency requires separate guest tests"]}
+        if args.report:
+            args.report.parent.mkdir(parents=True, exist_ok=True)
+            args.report.write_text(json.dumps(report, indent=2) + "\n")
+        print(json.dumps(report, indent=2))
+
+
+if __name__ == "__main__":
+    main()
