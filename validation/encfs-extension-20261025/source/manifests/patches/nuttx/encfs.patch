+#!/usr/bin/env python3
+# SPDX-License-Identifier: Apache-2.0
+"""Exercise actual keyslot, derivation and crypto C under ASan/UBSan.
+
+Only the external provider is replaced.  The live C paths perform key
+generation, AES-SIV sealing/opening, fail-closed parsing, CAS rotation and
+legacy-key rejection.  OpenSSL independently checks the serialized slots.
+The public byte-pattern keys in this test are fixtures, not real secrets.
+"""
+
+import importlib.util
+import os
+from pathlib import Path
+import subprocess
+import tempfile
+
+
+NUTTX = Path(__file__).resolve().parents[3]
+
+HARNESS = r'''
+#include <assert.h>
+#include <errno.h>
+#include <stdbool.h>
+#include <stdint.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+#include <nuttx/fs/encfs.h>
+#include "encfs.h"
+
+static uint8_t stored[ENCFS_KEYSLOT_SIZE];
+static uint8_t masters[3][ENCFS_MASTER_KEY_SIZE];
+static bool present;
+static bool available[3] = {true, true, true};
+static int read_error;
+static int random_error;
+static int commit_error;
+static unsigned int reads;
+static unsigned int commits;
+static unsigned int randoms;
+static unsigned int checks;
+
+#define CHECK(x) do { if (!(x)) {fprintf(stderr, "line %d\n", __LINE__); \
+                                  abort();} checks++; } while (0)
+
+int board_uniquekey(void *key)
+{
+  memset(key, 0x42, ENCFS_MASTER_KEY_SIZE);
+  return 0;
+}
+
+static int master(void *context, uint32_t id, uint8_t *key)
+{
+  (void)context;
+  if (id >= 3 || !available[id]) return -ENOKEY;
+  memcpy(key, masters[id], ENCFS_MASTER_KEY_SIZE);
+  return 0;
+}
+
+static int random_bytes(void *context, uint8_t *bytes, size_t length)
+{
+  size_t i;
+  (void)context;
+  randoms++;
+  if (random_error) return random_error;
+  for (i = 0; i < length; i++) bytes[i] = (uint8_t)(i ^ (randoms * 0x5b));
+  return 0;
+}
+
+static int read_slot(void *context, uint8_t *slot)
+{
+  (void)context;
+  reads++;
+  if (read_error) return read_error;
+  if (!present) return -ENOENT;
+  memcpy(slot, stored, sizeof(stored));
+  return 0;
+}
+
+static int exchange(void *context, const uint8_t *expected,
+                     const uint8_t *next)
+{
+  (void)context;
+  commits++;
+  if (commit_error) return commit_error;
+  if ((expected == NULL && present) ||
+      (expected != NULL && (!present ||
+       memcmp(expected, stored, sizeof(stored)) != 0))) return -ESTALE;
+  memcpy(stored, next, sizeof(stored));
+  present = true;
+  return 0;
+}
+
+static struct encfs_key_provider_s provider =
+{
+  .get_master = master,
+  .random = random_bytes,
+  .read_slot = read_slot,
+  .compare_exchange = exchange
+};
+
+static bool zeros(const void *p, size_t length)
+{
+  const uint8_t *b = p;
+  while (length--) if (*b++ != 0) return false;
+  return true;
+}
+
+static void save(const char *directory, const char *name,
+                  const void *bytes, size_t size)
+{
+  char path[1024];
+  FILE *file;
+  CHECK(snprintf(path, sizeof(path), "%s/%s", directory, name) > 0);
+  file = fopen(path, "wb");
+  CHECK(file != NULL);
+  CHECK(fwrite(bytes, 1, size, file) == size);
+  CHECK(fclose(file) == 0);
+}
+
+int main(int argc, char **argv)
+{
+  struct encfs_keys_s keys;
+  struct encfs_keys_s stable;
+  struct encfs_keys_s legacy;
+  struct encfs_status_s status = {0};
+  struct encfs_key_provider_s invalid;
+  enum encfs_stage_e stage;
+  uint8_t initial[ENCFS_KEYSLOT_SIZE];
+  uint8_t rotated[ENCFS_KEYSLOT_SIZE];
+  uint8_t saved_master[ENCFS_MASTER_KEY_SIZE];
+  unsigned int before;
+  unsigned int i;
+
+  CHECK(argc == 2);
+  for (i = 0; i < sizeof(masters); i++)
+    ((uint8_t *)masters)[i] = (uint8_t)(0x10 + i);
+
+  CHECK(encfs_key_set_provider(NULL) == 0);
+  CHECK(encfs_keys_acquire(false, &legacy, &stage) == 0);
+  CHECK(encfs_keys_rekey(1) == -ENOTSUP);
+  encfs_keys_status(&status);
+  CHECK(!status.key_wrapped && status.key_generation == 0);
+  CHECK(encfs_key_set_provider(&provider) == 0);
+
+  /* Selecting a wrapped provider makes missing slot fail closed. */
+  memset(&keys, 0xa5, sizeof(keys));
+  before = commits;
+  CHECK(encfs_keys_acquire(false, &keys, &stage) == -ENOKEY);
+  CHECK(zeros(&keys, sizeof(keys)) && commits == before && randoms == 0);
+  CHECK(encfs_keys_rekey(1) == -EINVAL);
+
+  /* Fresh wrapped volume: prepare does not publish before initialization. */
+  CHECK(encfs_keys_acquire(true, &stable, &stage) == 0);
+  CHECK(!present && randoms == 1);
+  CHECK(memcmp(&legacy, &stable, sizeof(stable)) != 0);
+  encfs_keys_status(&status);
+  CHECK(!status.key_wrapped);
+  CHECK(encfs_keys_commit() == 0 && present);
+  CHECK(encfs_keys_commit() == 0);
+  encfs_keys_status(&status);
+  CHECK(status.key_wrapped && status.master_id == 0 &&
+        status.key_generation == 1);
+  memcpy(initial, stored, sizeof(initial));
+  save(argv[1], "initial.slot", stored, sizeof(stored));
+  save(argv[1], "stable.keys", &stable, sizeof(stable));
+  save(argv[1], "masters.keys", masters, sizeof(masters));
+  CHECK(memcmp(stored, &stable, sizeof(stable)) != 0);
+
+  /* Missing next key and failed persistence leave current keyslot intact. */
+  CHECK(encfs_keys_rekey(999) == -ENOKEY);
+  CHECK(memcmp(stored, initial, sizeof(stored)) == 0);
+  commit_error = -EIO;
+  CHECK(encfs_keys_rekey(1) == -EIO);
+  CHECK(memcmp(stored, initial, sizeof(stored)) == 0);
+  encfs_keys_status(&status);
+  CHECK(status.master_id == 0 && status.key_generation == 1);
+  commit_error = 0;
+
+  /* Rotate with data keys unchanged, then simulate a cold start. */
+  CHECK(encfs_keys_rekey(1) == 0);
+  memcpy(rotated, stored, sizeof(rotated));
+  save(argv[1], "rotated.slot", stored, sizeof(stored));
+  CHECK(memcmp(initial, rotated, sizeof(rotated)) != 0 && randoms == 1);
+  encfs_keys_status(&status);
+  CHECK(status.master_id == 1 && status.key_generation == 2);
+  encfs_keys_forget();
+  CHECK(encfs_keys_acquire(false, &keys, &stage) == 0);
+  CHECK(memcmp(&keys, &stable, sizeof(keys)) == 0 && randoms == 1);
+
+  /* The old master cannot open the current keyslot by supplying its key
+   * for id 1. Decrypt must erase the complete output on every rejection.
+   */
+  memcpy(saved_master, masters[1], sizeof(saved_master));
+  memcpy(masters[1], masters[0], sizeof(saved_master));
+  CHECK(encfs_keys_acquire(false, &keys, &stage) == -EBADMSG);
+  CHECK(zeros(&keys, sizeof(keys)));
+  memcpy(masters[1], saved_master, sizeof(saved_master));
+  available[1] = false;
+  CHECK(encfs_keys_acquire(false, &keys, &stage) == -ENOKEY);
+  CHECK(zeros(&keys, sizeof(keys)));
+  available[1] = true;
+
+  /* Every serialized byte is either strictly parsed or authenticated. */
+  before = commits;
+  for (i = 0; i < sizeof(stored); i++)
+    {
+      memcpy(stored, rotated, sizeof(stored));
+      stored[i] ^= 0x80;
+      memset(&keys, 0xa5, sizeof(keys));
+      CHECK(encfs_keys_acquire(false, &keys, &stage) < 0);
+      CHECK(zeros(&keys, sizeof(keys)));
+      CHECK(commits == before && randoms == 1);
+    }
+
+  memcpy(stored, rotated, sizeof(stored));
+  CHECK(encfs_keys_acquire(false, &keys, &stage) == 0);
+  stored[100] ^= 1;
+  CHECK(encfs_keys_rekey(2) == -ESTALE);
+  CHECK(stored[100] == (uint8_t)(rotated[100] ^ 1));
+  encfs_keys_status(&status);
+  CHECK(status.master_id == 1 && status.key_generation == 2);
+  memcpy(stored, rotated, sizeof(stored));
+
+  /* Repeated live wrapping rotations never request fresh data keys. */
+  for (i = 0; i < 100; i++)
+    {
+      CHECK(encfs_keys_rekey(i % 3) == 0);
+      encfs_keys_status(&status);
+      CHECK(status.master_id == i % 3 && status.key_generation == i + 3);
+      encfs_keys_forget();
+      CHECK(encfs_keys_acquire(false, &keys, &stage) == 0);
+      CHECK(memcmp(&keys, &stable, sizeof(keys)) == 0 && randoms == 1);
+    }
+
+  invalid = provider;
+  invalid.compare_exchange = NULL;
+  CHECK(encfs_key_set_provider(&invalid) == -EINVAL);
+  CHECK(encfs_keys_rekey(1) == 0);
+  read_error = -EIO;
+  CHECK(encfs_keys_acquire(false, &keys, &stage) == -EIO);
+  CHECK(zeros(&keys, sizeof(keys)));
+  read_error = 0;
+
+  /* Provision failure paths do not publish metadata. */
+  before = commits;
+  random_error = -EIO;
+  CHECK(encfs_keys_acquire(true, &keys, &stage) == -EIO);
+  CHECK(zeros(&keys, sizeof(keys)) && commits == before);
+  random_error = 0;
+  CHECK(encfs_keys_acquire(true, &keys, &stage) == 0);
+  CHECK(memcmp(&keys, &stable, sizeof(keys)) != 0);
+  commit_error = -ENOSPC;
+  CHECK(encfs_keys_commit() == -ENOSPC);
+  encfs_keys_status(&status);
+  CHECK(!status.key_wrapped);
+  commit_error = 0;
+  encfs_keys_forget();
+
+  /* Provider removal restores the unchanged legacy derivation. */
+  CHECK(encfs_key_set_provider(NULL) == 0);
+  CHECK(encfs_keys_acquire(false, &keys, &stage) == 0);
+  CHECK(memcmp(&keys, &legacy, sizeof(keys)) == 0);
+  CHECK(encfs_keys_rekey(1) == -ENOTSUP);
+  printf("ENCFS_KEYWRAP_TEST_RESULT checks=%u fail=0 reads=%u commits=%u\n",
+         checks, reads, commits);
+  return 0;
+}
+'''
+
+
+def main():
+    with tempfile.TemporaryDirectory(prefix="encfs-keywrap-") as name:
