+            "-Wall", "-Wextra", "-Werror", "-Wno-old-style-declaration",
+            "-fsanitize=address,undefined", "-fno-sanitize-recover=all",
+            "-include", str(prelude), "-I", str(inc),
+            "-I", str(NUTTX / "fs/encfs"), str(root / "test.c"),
+            *map(str, sources), "-o", str(executable),
+        ], check=True)
+        env = os.environ.copy()
+        # The Codex sandbox uses ptrace; LSan cannot inspect its threads.
+        # Address and undefined-behavior instrumentation remain active.
+        env["ASAN_OPTIONS"] = "detect_leaks=0"
+        subprocess.run([str(executable), str(root)], check=True, env=env)
+
+        # This independent implementation does not call the NuttX cipher.
+        spec = importlib.util.spec_from_file_location(
+            "encfs_crypto_reference",
+            NUTTX / "tools/tests/encfs_crypto/test_crypto.py")
+        module = importlib.util.module_from_spec(spec)
+        spec.loader.exec_module(module)
+        reference = module.OpenSSLSIV()
+        try:
+            stable = (root / "stable.keys").read_bytes()
+            masters = (root / "masters.keys").read_bytes()
+            for filename in ("initial.slot", "rotated.slot"):
+                slot = (root / filename).read_bytes()
+                keyid = int.from_bytes(slot[12:16], "little")
+                key = masters[keyid * 32:(keyid + 1) * 32]
+                wrapping = module.reference_hkdf(
+                    key, b"encfs-keyslot-v1", slot[:32], 32)
+                assert reference.seal(wrapping, [slot[:32]], stable) == slot[32:]
+            print("OPENSSL_KEYSLOT_REFERENCE_RESULT slots=2 fail=0")
+        finally:
+            reference.close()
+
+
+if __name__ == "__main__":
+    main()
