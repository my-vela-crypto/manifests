index 0000000000000000000000000000000000000000..1ba0a69af50acc5ba6da7ebbd47b9aa509180c7f
--- /dev/null
+++ b/include/nuttx/fs/encfs.h
@@ -0,0 +1,198 @@
+/****************************************************************************
+ * include/nuttx/fs/encfs.h
+ *
+ * SPDX-License-Identifier: Apache-2.0
+ *
+ ****************************************************************************/
+
+#ifndef __INCLUDE_NUTTX_FS_ENCFS_H
+#define __INCLUDE_NUTTX_FS_ENCFS_H
+
+/****************************************************************************
+ * Included Files
+ ****************************************************************************/
+
+#include <nuttx/config.h>
+#include <nuttx/compiler.h>
+
+#include <stdbool.h>
+#include <stddef.h>
+#include <stdint.h>
+
+/****************************************************************************
+ * Pre-processor Definitions
+ ****************************************************************************/
+
+#define ENCFS_MASTER_KEY_SIZE 32
+#define ENCFS_BLOCK_DEVICE    "/dev/encdata0"
+#define ENCFS_PARENT_DEVICE   "/dev/virtblk1"
+#define ENCFS_LOWER_PATH      "/datap"
+#define ENCFS_UPPER_PATH      "/data"
+
+/****************************************************************************
+ * Public Types
+ ****************************************************************************/
+
+enum encfs_state_e
+{
+  ENCFS_STOPPED = 0,
+  ENCFS_BLOCK_REGISTERED,
+  ENCFS_BLOCK_KEYED,
+  ENCFS_LOWER_MOUNTED,
+  ENCFS_READY
+};
+
+enum encfs_stage_e
+{
+  ENCFS_STAGE_NONE = 0,
+  ENCFS_STAGE_REGISTER,
+  ENCFS_STAGE_MASTER,
+  ENCFS_STAGE_DERIVE,
+  ENCFS_STAGE_BLOCK_KEY,
+  ENCFS_STAGE_LOWER_MOUNT,
+  ENCFS_STAGE_FORMAT,
+  ENCFS_STAGE_PATH_KEY,
+  ENCFS_STAGE_UPPER_MOUNT,
+  ENCFS_STAGE_INITIALIZE,
+  ENCFS_STAGE_UPPER_UMOUNT,
+  ENCFS_STAGE_LOWER_UMOUNT,
+  ENCFS_STAGE_UNREGISTER,
+  ENCFS_STAGE_PREPARE_UPPER,
+  ENCFS_STAGE_KEYSLOT,
+  ENCFS_STAGE_REKEY
+};
+
+/* The resource fields describe what is still owned after an error.  error
+ * and stage retain the original failure; cleanup_error and cleanup_stage
+ * describe a subsequent rollback failure.  A busy stop leaves READY intact.
+ */
+
+struct encfs_status_s
+{
+  enum encfs_state_e state;
+  enum encfs_stage_e stage;
+  int error;
+  enum encfs_stage_e cleanup_stage;
+  int cleanup_error;
+  bool block_registered;
+  bool block_keyed;
+  bool lower_visible;
+  bool upper_mounted;
+  bool path_key_staged;
+#ifdef CONFIG_ENCFS_KEYWRAP
+  bool key_wrapped;
+  uint32_t master_id;
+  uint64_t key_generation;
+#endif
+};
+
+/****************************************************************************
+ * Public Function Prototypes
+ ****************************************************************************/
+
+#ifdef __cplusplus
+extern "C"
+{
+#endif
+
+/* All interfaces return zero or a negated errno.  start is idempotent when
+ * READY, never formats, and authenticates existing path metadata.  stop is
+ * idempotent when STOPPED and returns -EBUSY while handles remain open.
+ *
+ * DESTRUCTIVE: provision formats the entire encrypted data volume as exFAT
+ * and initializes its authenticated path metadata.  Invoke only after an
+ * explicit user request to erase the data disk.  It leaves the volume
+ * stopped.
+ */
+
+int encfs_start(void);
+int encfs_stop(void);
+int encfs_provision(void);
+int encfs_get_status(FAR struct encfs_status_s *status);
+
+#ifdef CONFIG_ENCFS_KEYWRAP
+/* A wrapping provider is independent of /data and /datap.  Its context and
+ * callbacks must remain alive until it is replaced while fully STOPPED.
+ * Callbacks run with the manager mutex held and must not call back into it.
+ * get_master supplies a 32-byte key for an opaque provider key identifier;
+ * identifiers denote immutable, distinct master versions. Reusing the same
+ * current identifier returns -EALREADY instead of claiming a key rotation.
+ * random supplies fresh cryptographic random bytes for a new volume.
+ * read_slot returns 0 with exactly ENCFS_KEYSLOT_SIZE bytes, or -ENOENT.
+ * compare_exchange atomically and durably replaces the slot iff its bytes
+ * match expected (NULL means absent), otherwise returns -ESTALE.  On any
+ * negative return the old slot MUST remain intact.  A real backend must
+ * implement that guarantee across power loss; the test file provider only
+ * models process interruption and host atomic rename, not physical power
+ * loss.  A trusted monotonic store is needed for rollback resistance.
+ *
+ * With a provider selected, missing/corrupt slots fail closed: normal start
+ * never falls back to a legacy key.  New provision generates independent
+ * data keys.  Legacy directly-derived volumes remain supported with NULL
+ * provider but cannot be rekeyed: their original master could still derive
+ * the data keys.  Migrating those volumes requires a separate data copy.
+ */
+
+#define ENCFS_KEYSLOT_SIZE 112
+
+struct encfs_key_provider_s
+{
+  FAR void *context;
+  CODE int (*get_master)(FAR void *context, uint32_t id,
+                         FAR uint8_t key[ENCFS_MASTER_KEY_SIZE]);
+  CODE int (*random)(FAR void *context, FAR uint8_t *bytes, size_t length);
+  CODE int (*read_slot)(FAR void *context,
+                        FAR uint8_t slot[ENCFS_KEYSLOT_SIZE]);
+  CODE int (*compare_exchange)(FAR void *context,
+                               FAR const uint8_t *expected,
+                               FAR const uint8_t next[ENCFS_KEYSLOT_SIZE]);
+};
+
+int encfs_set_key_provider(FAR const struct encfs_key_provider_s *provider);
+int encfs_rekey(uint32_t master_id);
+
+#ifdef CONFIG_ENCFS_TESTING
+/* Simulator ONLY: 32-byte master-%08x.bin files, a one-use 64-byte
+ * volume-random.bin, and an authenticated encfs.keyslot in an independent
+ * hostfs directory.  Secret files on the host are NOT a hardware keystore.
+ */
+
+int encfs_test_use_keyfiles(FAR const char *directory);
+int encfs_test_keyslot_fail_commit(bool enabled);
+int encfs_test_keyslot_pause_commit(unsigned int milliseconds);
+#endif
+#endif
+
+#ifdef CONFIG_ENCFS_TESTING
+/* Test interfaces are excluded from production builds.  Key changes require
+ * STOPPED with no resources left over.  NULL/0 selects a missing key
+ * provider;
+ * a non-NULL key must have exactly ENCFS_MASTER_KEY_SIZE bytes.
+ * use_board_key
+ * erases the test key and restores the board provider.
+ */
+
+enum encfs_test_failpoint_e
+{
+  ENCFS_TEST_FAIL_NONE = 0,
+  ENCFS_TEST_FAIL_REGISTER,
+  ENCFS_TEST_FAIL_KEY,
+  ENCFS_TEST_FAIL_LOWER,
+  ENCFS_TEST_FAIL_UPPER
+};
+
+int encfs_test_set_master(FAR const uint8_t *key, size_t keylen);
+int encfs_test_use_board_key(void);
+
+/* Failpoints fail once with -EIO immediately before the selected operation.
+ * A subsequent start can retry without resetting the failpoint.
+ */
+
+int encfs_test_set_failpoint(enum encfs_test_failpoint_e failpoint);
+#endif
+
+#ifdef __cplusplus
+}
+#endif
+
+#endif /* __INCLUDE_NUTTX_FS_ENCFS_H */
