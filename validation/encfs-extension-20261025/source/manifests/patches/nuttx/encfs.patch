diff --git a/fs/encpathfs/encpathfs.h b/fs/encpathfs/encpathfs.h
new file mode 100644
index 0000000000000000000000000000000000000000..c68a31303ed47cd23aa97b09f4d5c9b899a3d71f
--- /dev/null
+++ b/fs/encpathfs/encpathfs.h
@@ -0,0 +1,104 @@
+/****************************************************************************
+ * fs/encpathfs/encpathfs.h
+ *
+ * SPDX-License-Identifier: Apache-2.0
+ ****************************************************************************/
+
+#ifndef __FS_ENCPATHFS_ENCPATHFS_H
+#define __FS_ENCPATHFS_ENCPATHFS_H
+
+#include <nuttx/config.h>
+#include <nuttx/fs/fs.h>
+#include <nuttx/fs/encpathfs.h>
+#include <nuttx/mutex.h>
+#include <sys/stat.h>
+#include <sys/statfs.h>
+#include <stdbool.h>
+#include <limits.h>
+
+#include "fs_heap.h"
+
+#define ENCPATHFS_ROOT ".p"
+#define ENCPATHFS_META ".encfs.meta"
+
+struct encpathfs_file_s;
+struct encpathfs_dir_s;
+
+/* All lower operations run under this lock.  Lower file/dir objects are
+ * constructed directly and never exposed to the public inode namespace.
+ */
+
+struct encpathfs_mount_s
+{
+  FAR struct inode *lower;
+  mutex_t lock;
+  unsigned int files;
+  unsigned int dirs;
+  uint8_t key[ENCPATHFS_KEY_SIZE];
+  FAR struct encpathfs_file_s *head;
+  FAR struct encpathfs_dir_s *dhead;
+};
+
+struct encpathfs_file_s
+{
+  struct file lower;
+  FAR struct encpathfs_mount_s *mount;
+  FAR char *logical;
+  FAR struct encpathfs_file_s *next;
+  FAR struct inode *orphan_inode;
+};
+
+struct encpathfs_dir_s
+{
+  struct fs_dirent_s base;
+  FAR struct fs_dirent_s *lower;
+  FAR struct encpathfs_dir_s *next;
+  bool orphan;
+};
+
+void encpathfs_erase(FAR void *memory, size_t length);
+int encpathfs_path(FAR struct encpathfs_mount_s *mount,
+                  FAR const char *relative, FAR char **physical,
+                  FAR char **logical);
+int encpathfs_flush(FAR struct encpathfs_mount_s *mount);
+int encpathfs_bind(FAR struct inode *blkdriver, FAR const void *data,
+                  FAR void **handle);
+int encpathfs_unbind(FAR void *handle, FAR struct inode **blkdriver,
+                    unsigned int flags);
+int encpathfs_statfs(FAR struct inode *inode, FAR struct statfs *buf);
+int encpathfs_syncfs(FAR struct inode *inode);
+
+int encpathfs_open(FAR struct file *filep, FAR const char *path,
+                  int oflags, mode_t mode);
+int encpathfs_close(FAR struct file *filep);
+ssize_t encpathfs_read(FAR struct file *filep, FAR char *buffer,
+                      size_t length);
+ssize_t encpathfs_write(FAR struct file *filep, FAR const char *buffer,
+                       size_t length);
+off_t encpathfs_seek(FAR struct file *filep, off_t offset, int whence);
+int encpathfs_ioctl(FAR struct file *filep, int cmd, unsigned long arg);
+int encpathfs_sync(FAR struct file *filep);
+int encpathfs_dup(FAR const struct file *oldp, FAR struct file *newp);
+int encpathfs_fstat(FAR const struct file *filep, FAR struct stat *buf);
+int encpathfs_fchstat(FAR const struct file *filep,
+                     FAR const struct stat *buf, int flags);
+int encpathfs_truncate(FAR struct file *filep, off_t length);
+
+int encpathfs_opendir(FAR struct inode *inode, FAR const char *path,
+                     FAR struct fs_dirent_s **dir);
+int encpathfs_closedir(FAR struct inode *inode, FAR struct fs_dirent_s *dir);
+int encpathfs_readdir(FAR struct inode *inode, FAR struct fs_dirent_s *dir,
+                     FAR struct dirent *entry);
+int encpathfs_rewinddir(FAR struct inode *inode, FAR struct fs_dirent_s *dir);
+int encpathfs_unlink(FAR struct inode *inode, FAR const char *path);
+int encpathfs_mkdir(FAR struct inode *inode, FAR const char *path,
+                   mode_t mode);
+int encpathfs_rmdir(FAR struct inode *inode, FAR const char *path);
+int encpathfs_rename(FAR struct inode *inode, FAR const char *oldpath,
+                    FAR const char *newpath);
+int encpathfs_stat(FAR struct inode *inode, FAR const char *path,
+                  FAR struct stat *buf);
+int encpathfs_chstat(FAR struct inode *inode, FAR const char *path,
+                    FAR const struct stat *buf, int flags);
+
+#endif /* __FS_ENCPATHFS_ENCPATHFS_H */
diff --git a/fs/encpathfs/encpathfs_codec.c b/fs/encpathfs/encpathfs_codec.c
new file mode 100644
index 0000000000000000000000000000000000000000..038e155911f5b9cc69fa3a8a76ea653e8318432e
--- /dev/null
+++ b/fs/encpathfs/encpathfs_codec.c
@@ -0,0 +1,281 @@
+/****************************************************************************
+ * fs/encpathfs/encpathfs_codec.c
+ *
+ * SPDX-License-Identifier: Apache-2.0
+ ****************************************************************************/
+
+/****************************************************************************
+ * Included Files
+ ****************************************************************************/
+
+#include <nuttx/config.h>
+#include <nuttx/crypto/aes_siv.h>
+#include <nuttx/fs/encpathfs.h>
+#include <errno.h>
+#include <stdbool.h>
+#include <string.h>
+
+/****************************************************************************
+ * Private Data
+ ****************************************************************************/
+
+static const uint8_t g_name_ad[] = "encpathfs:name:v1";
+static const char g_alphabet[] = "0123456789ABCDEFGHIJKLMNOPQRSTUV";
+
+/****************************************************************************
+ * Private Functions
+ ****************************************************************************/
+
+static bool encpathfs_valid_name(FAR const char *name, size_t length)
+{
+  uint32_t scalar;
+  uint32_t minimum;
+  unsigned int continuation;
+  uint8_t byte;
+  size_t i = 0;
+
+  if (length == 0 || length > ENCPATHFS_NAME_MAX ||
+      (length == 1 && name[0] == '.') ||
+      (length == 2 && name[0] == '.' && name[1] == '.'))
+    {
+      return false;
+    }
+
+  /* RFC 3629 UTF-8, independent of the current locale.  Decode the scalar
+   * to exclude overlong sequences, UTF-16 surrogates and values beyond
+   * U+10FFFF.  In particular an overlong '/' or NUL cannot bypass the
+   * component restrictions.  Keep the original printable ASCII policy.
+   */
+
+  while (i < length)
+    {
+      byte = (uint8_t)name[i++];
+      if (byte <= 0x7f)
+        {
+          if (byte < 0x20 || byte == 0x7f || byte == '/')
+            {
+              return false;
+            }
+
+          continue;
+        }
+
+      if (byte >= 0xc2 && byte <= 0xdf)
+        {
+          scalar = byte & 0x1f;
+          minimum = 0x80;
+          continuation = 1;
+        }
+      else if (byte >= 0xe0 && byte <= 0xef)
+        {
+          scalar = byte & 0x0f;
+          minimum = 0x800;
+          continuation = 2;
+        }
+      else if (byte >= 0xf0 && byte <= 0xf4)
+        {
+          scalar = byte & 0x07;
+          minimum = 0x10000;
+          continuation = 3;
+        }
+      else
+        {
+          return false;
+        }
+
+      if (length - i < continuation)
+        {
+          return false;
+        }
+
+      while (continuation-- > 0)
+        {
+          byte = (uint8_t)name[i++];
+          if ((byte & 0xc0) != 0x80)
+            {
+              return false;
+            }
+
+          scalar = (scalar << 6) | (byte & 0x3f);
+        }
+
+      if (scalar < minimum || scalar > 0x10ffff ||
+          (scalar >= 0xd800 && scalar <= 0xdfff))
+        {
+          return false;
+        }
+    }
+
+  return true;
+}
+
+/****************************************************************************
+ * Public Functions
+ ****************************************************************************/
+
+void encpathfs_erase(FAR void *memory, size_t length)
+{
+  FAR volatile uint8_t *p = memory;
+
+  while (length-- > 0)
+    {
+      *p++ = 0;
+    }
+}
+
+int encpathfs_encode_name(FAR const uint8_t *key, FAR const char *name,
+                         FAR char *encoded, size_t capacity)
+{
+  uint8_t sealed[16 + ENCPATHFS_NAME_MAX];
+  uint32_t bits = 0;
+  unsigned int count = 0;
+  size_t length;
+  size_t out = 3;
+  size_t i;
+  int ret;
+
+  if (key == NULL || name == NULL || encoded == NULL)
+    {
+      return -EINVAL;
+    }
+
+  length = strnlen(name, ENCPATHFS_NAME_MAX + 1);
+  if (length > ENCPATHFS_NAME_MAX)
+    {
+      return -ENAMETOOLONG;
+    }
+
+  if (!encpathfs_valid_name(name, length))
+    {
+      return -EINVAL;
+    }
+
+  if (capacity <= 3 + ((length + 16) * 8 + 4) / 5)
+    {
+      return -ENAMETOOLONG;
+    }
+
+  ret = aes_siv_encrypt(key, g_name_ad, sizeof(g_name_ad) - 1,
+                        (FAR const uint8_t *)name, length, sealed);
+  if (ret < 0)
+    {
+      encpathfs_erase(sealed, sizeof(sealed));
+      return ret;
+    }
+
+  memcpy(encoded, "E1_", 3);
+  for (i = 0; i < length + 16; i++)
+    {
+      bits = (bits << 8) | sealed[i];
+      count += 8;
+      while (count >= 5)
+        {
+          count -= 5;
+          encoded[out++] = g_alphabet[(bits >> count) & 31];
+        }
+    }
+
+  if (count != 0)
+    {
+      encoded[out++] = g_alphabet[(bits << (5 - count)) & 31];
+    }
+
+  encoded[out] = '\0';
+  encpathfs_erase(sealed, sizeof(sealed));
+  return 0;
+}
+
+int encpathfs_decode_name(FAR const uint8_t *key, FAR const char *encoded,
+                         FAR char *name, size_t capacity)
+{
+  uint8_t sealed[16 + ENCPATHFS_NAME_MAX];
+  char plain[ENCPATHFS_NAME_MAX + 1];
+  uint32_t bits = 0;
+  unsigned int count = 0;
+  size_t length;
+  size_t nsealed = 0;
+  size_t i;
+  int value;
+  int ret = -EBADMSG;
+
+  if (key == NULL || encoded == NULL || name == NULL)
+    {
+      return -EINVAL;
+    }
+
+  if (capacity > 0)
+    {
+      name[0] = '\0';
+    }
+
+  length = strnlen(encoded, ENCPATHFS_ENCODED_MAX + 1);
+  if (length < 31 || length > ENCPATHFS_ENCODED_MAX ||
+      memcmp(encoded, "E1_", 3) != 0)
+    {
+      return -EBADMSG;
+    }
+
+  for (i = 3; i < length; i++)
+    {
+      if (encoded[i] >= '0' && encoded[i] <= '9')
+        {
+          value = encoded[i] - '0';
+        }
+      else if (encoded[i] >= 'A' && encoded[i] <= 'V')
+        {
+          value = encoded[i] - 'A' + 10;
+        }
+      else
+        {
+          goto out;
+        }
+
+      bits = (bits << 5) | value;
+      count += 5;
+      if (count >= 8)
+        {
+          count -= 8;
+          if (nsealed == sizeof(sealed))
+            {
+              goto out;
+            }
+
+          sealed[nsealed++] = (bits >> count) & 255;
+        }
+    }
+
+  /* Reject non-canonical lengths and nonzero unused trailing bits. */
+
+  if (nsealed <= 16 || (nsealed * 8 + 4) / 5 != length - 3 ||
+      (bits & ((1u << count) - 1)) != 0)
+    {
+      goto out;
+    }
+
+  ret = aes_siv_decrypt(key, g_name_ad, sizeof(g_name_ad) - 1,
+                        sealed, nsealed, (FAR uint8_t *)plain);
+  if (ret < 0)
+    {
+      goto out;
+    }
+
+  if (!encpathfs_valid_name(plain, nsealed - 16))
+    {
+      ret = -EBADMSG;
+      goto out;
+    }
+
+  if (capacity <= nsealed - 16)
+    {
+      ret = -ENAMETOOLONG;
+      goto out;
+    }
+
+  memcpy(name, plain, nsealed - 16);
+  name[nsealed - 16] = '\0';
+  ret = 0;
+out:
+  encpathfs_erase(plain, sizeof(plain));
+  encpathfs_erase(sealed, sizeof(sealed));
+  return ret;
+}
diff --git a/fs/encpathfs/encpathfs_dir.c b/fs/encpathfs/encpathfs_dir.c
new file mode 100644
index 0000000000000000000000000000000000000000..321173c08843f21ffb6a6ea9229c4801c35d0bab
--- /dev/null
+++ b/fs/encpathfs/encpathfs_dir.c
@@ -0,0 +1,354 @@
+/****************************************************************************
+ * fs/encpathfs/encpathfs_dir.c
+ *
+ * SPDX-License-Identifier: Apache-2.0
+ ****************************************************************************/
+
+#include <nuttx/config.h>
+#include <errno.h>
+#include <string.h>
+#include "encpathfs.h"
+
+int encpathfs_opendir(FAR struct inode *inode, FAR const char *path,
+                     FAR struct fs_dirent_s **dir)
+{
+  FAR struct encpathfs_mount_s *mount = inode->i_private;
+  FAR struct encpathfs_dir_s *priv;
+  FAR char *physical = NULL;
+  int ret;
+
+  priv = fs_heap_zalloc(sizeof(*priv));
+  if (priv == NULL)
+    {
+      return -ENOMEM;
+    }
+
+  ret = nxmutex_lock(&mount->lock);
+  if (ret >= 0)
+    {
+      ret = encpathfs_path(mount, path, &physical, NULL);
+      if (ret >= 0)
+        {
+          ret = mount->lower->u.i_mops->opendir(mount->lower, physical,
+                                               &priv->lower);
+        }
+
+      if (ret >= 0)
+        {
+          priv->next = mount->dhead;
+          mount->dhead = priv;
+          mount->dirs++;
+          *dir = &priv->base;
+        }
+
+      nxmutex_unlock(&mount->lock);
+    }
+
+  fs_heap_free(physical);
+  if (ret < 0)
+    {
+      fs_heap_free(priv);
+    }
+
+  return ret;
+}
+
+int encpathfs_closedir(FAR struct inode *inode, FAR struct fs_dirent_s *dir)
+{
+  FAR struct encpathfs_mount_s *mount = inode->i_private;
+  FAR struct encpathfs_dir_s *priv = (FAR struct encpathfs_dir_s *)dir;
+  FAR struct encpathfs_dir_s **link;
+  int ret = nxmutex_lock(&mount->lock);
+
+  if (ret >= 0)
+    {
+      ret = mount->lower->u.i_mops->closedir(mount->lower, priv->lower);
+      mount->dirs--;
+      if (ret < 0)
+        {
+          /* VFS releases its directory wrapper and inode reference even
+           * when the lower close fails.  Preserve the lower object until
+           * syncfs or unbind can finish closing it.
+           */
+
+          priv->orphan = true;
+          nxmutex_unlock(&mount->lock);
+          return ret;
+        }
+
+      for (link = &mount->dhead; *link != priv; link = &(*link)->next)
+        {
+        }
+
+      *link = priv->next;
+      nxmutex_unlock(&mount->lock);
+      fs_heap_free(priv);
+    }
+
+  return ret;
+}
+
+int encpathfs_readdir(FAR struct inode *inode, FAR struct fs_dirent_s *dir,
+                     FAR struct dirent *entry)
+{
+  FAR struct encpathfs_mount_s *mount = inode->i_private;
+  FAR struct encpathfs_dir_s *priv = (FAR struct encpathfs_dir_s *)dir;
+  struct dirent lower_entry;
+  int ret = nxmutex_lock(&mount->lock);
+
+  if (ret >= 0)
+    {
+      do
+        {
+          memset(&lower_entry, 0, sizeof(lower_entry));
+          ret = mount->lower->u.i_mops->readdir(mount->lower, priv->lower,
+                                               &lower_entry);
+        }
+      while (ret >= 0 && (!strcmp(lower_entry.d_name, ".") ||
+                          !strcmp(lower_entry.d_name, "..")));
+
+      if (ret >= 0)
+        {
+          ret = encpathfs_decode_name(mount->key, lower_entry.d_name,
+                                      entry->d_name, sizeof(entry->d_name));
+          if (ret >= 0)
+            {
+              entry->d_type = lower_entry.d_type;
+            }
+        }
+
+      nxmutex_unlock(&mount->lock);
+    }
+
+  if (ret < 0)
+    {
+      entry->d_name[0] = '\0';
+    }
+
+  return ret;
+}
+
+int encpathfs_rewinddir(FAR struct inode *inode, FAR struct fs_dirent_s *dir)
+{
+  FAR struct encpathfs_mount_s *mount = inode->i_private;
+  FAR struct encpathfs_dir_s *priv = (FAR struct encpathfs_dir_s *)dir;
+  int ret = nxmutex_lock(&mount->lock);
+
+  if (ret >= 0)
+    {
+      ret = mount->lower->u.i_mops->rewinddir(mount->lower, priv->lower);
+      nxmutex_unlock(&mount->lock);
+    }
+
+  return ret;
+}
+
+int encpathfs_unlink(FAR struct inode *inode, FAR const char *path)
+{
+  FAR struct encpathfs_mount_s *mount = inode->i_private;
+  FAR char *physical = NULL;
+  struct stat st;
+  int ret = nxmutex_lock(&mount->lock);
+
+  if (ret >= 0)
+    {
+      ret = encpathfs_path(mount, path, &physical, NULL);
+      if (ret >= 0)
+        {
+          if (!strcmp(physical, ENCPATHFS_ROOT))
+            {
+              ret = -EBUSY;
+            }
+          else
+            {
+              ret = mount->lower->u.i_mops->stat(mount->lower, physical, &st);
+              if (ret >= 0)
+                {
+                  ret = S_ISDIR(st.st_mode) ? -EISDIR :
+                        mount->lower->u.i_mops->unlink(mount->lower,
+                                                        physical);
+                }
+            }
+        }
+
+      nxmutex_unlock(&mount->lock);
+    }
+
+  fs_heap_free(physical);
+  return ret;
+}
+
+int encpathfs_mkdir(FAR struct inode *inode, FAR const char *path, mode_t mode)
+{
+  FAR struct encpathfs_mount_s *mount = inode->i_private;
+  FAR char *physical = NULL;
+  FAR char *trimmed;
+  size_t length;
+  int ret;
+
+  if (path == NULL)
+    {
+      return -EINVAL;
+    }
+
+  length = strnlen(path, PATH_MAX);
+  if (length == PATH_MAX)
+    {
+      return -ENAMETOOLONG;
+    }
+
+  while (length > 0 && path[length - 1] == '/')
+    {
+      length--;
+    }
+
+  /* A trailing slash is legal when creating a new directory; the shared
+   * path helper requires existing directories for other trailing slashes.
+   */
+
+  trimmed = fs_heap_strndup(path, length);
+  if (trimmed == NULL)
+    {
+      return -ENOMEM;
+    }
+
+  ret = nxmutex_lock(&mount->lock);
+
+  if (ret >= 0)
+    {
+      ret = encpathfs_path(mount, trimmed, &physical, NULL);
+      if (ret >= 0)
+        {
+          ret = !strcmp(physical, ENCPATHFS_ROOT) ? -EEXIST :
+                mount->lower->u.i_mops->mkdir(mount->lower, physical, mode);
+        }
+
+      nxmutex_unlock(&mount->lock);
+    }
+
+  fs_heap_free(physical);
+  fs_heap_free(trimmed);
+  return ret;
+}
+
+int encpathfs_rmdir(FAR struct inode *inode, FAR const char *path)
+{
+  FAR struct encpathfs_mount_s *mount = inode->i_private;
+  FAR char *physical = NULL;
+  int ret = nxmutex_lock(&mount->lock);
+
+  if (ret >= 0)
+    {
+      ret = encpathfs_path(mount, path, &physical, NULL);
+      if (ret >= 0)
+        {
+          ret = !strcmp(physical, ENCPATHFS_ROOT) ? -EBUSY :
+                mount->lower->u.i_mops->rmdir(mount->lower, physical);
+        }
+
+      nxmutex_unlock(&mount->lock);
+    }
+
+  fs_heap_free(physical);
+  return ret;
+}
+
+int encpathfs_rename(FAR struct inode *inode, FAR const char *oldpath,
+                    FAR const char *newpath)
+{
+  FAR struct encpathfs_mount_s *mount = inode->i_private;
+  FAR char *oldphysical = NULL;
+  FAR char *newphysical = NULL;
+  struct stat st;
+  int ret = nxmutex_lock(&mount->lock);
+
+  if (ret < 0)
+    {
+      return ret;
+    }
+
+  ret = encpathfs_path(mount, oldpath, &oldphysical, NULL);
+  if (ret >= 0)
+    {
+      ret = encpathfs_path(mount, newpath, &newphysical, NULL);
+    }
+
+  if (ret < 0)
+    {
+      goto out;
+    }
+
+  if (!strcmp(oldphysical, ENCPATHFS_ROOT) ||
+      !strcmp(newphysical, ENCPATHFS_ROOT))
+    {
+      ret = -EBUSY;
+      goto out;
+    }
+
+  /* FAT does not implement POSIX replacement.  Serialize the existence
+   * check with all other upper mutations and explicitly reject it.
+   */
+
+  ret = mount->lower->u.i_mops->stat(mount->lower, newphysical, &st);
+  if (ret >= 0)
+    {
+      ret = -EEXIST;
+    }
+  else if (ret == -ENOENT)
+    {
+      ret = mount->lower->u.i_mops->rename(mount->lower, oldphysical,
+                                          newphysical);
+    }
+
+out:
+  nxmutex_unlock(&mount->lock);
+  fs_heap_free(oldphysical);
+  fs_heap_free(newphysical);
+  return ret;
+}
+
+int encpathfs_stat(FAR struct inode *inode, FAR const char *path,
+                  FAR struct stat *buf)
+{
+  FAR struct encpathfs_mount_s *mount = inode->i_private;
+  FAR char *physical = NULL;
+  int ret = nxmutex_lock(&mount->lock);
+
+  if (ret >= 0)
+    {
+      ret = encpathfs_path(mount, path, &physical, NULL);
+      if (ret >= 0)
+        {
+          ret = mount->lower->u.i_mops->stat(mount->lower, physical, buf);
+        }
+
+      nxmutex_unlock(&mount->lock);
+    }
+
+  fs_heap_free(physical);
+  return ret;
+}
+
+int encpathfs_chstat(FAR struct inode *inode, FAR const char *path,
+                    FAR const struct stat *buf, int flags)
+{
+  FAR struct encpathfs_mount_s *mount = inode->i_private;
+  FAR char *physical = NULL;
+  int ret = nxmutex_lock(&mount->lock);
+
+  if (ret >= 0)
+    {
+      ret = encpathfs_path(mount, path, &physical, NULL);
+      if (ret >= 0)
+        {
+          ret = mount->lower->u.i_mops->chstat == NULL ? -ENOSYS :
+                mount->lower->u.i_mops->chstat(mount->lower, physical,
+                                               buf, flags);
+        }
+
+      nxmutex_unlock(&mount->lock);
+    }
+
+  fs_heap_free(physical);
+  return ret;
+}
diff --git a/fs/encpathfs/encpathfs_file.c b/fs/encpathfs/encpathfs_file.c
new file mode 100644
index 0000000000000000000000000000000000000000..c75552f8f8473171b8e06b1ae57b9edaa5e3b6d6
--- /dev/null
+++ b/fs/encpathfs/encpathfs_file.c
@@ -0,0 +1,346 @@
+/****************************************************************************
+ * fs/encpathfs/encpathfs_file.c
+ *
+ * SPDX-License-Identifier: Apache-2.0
+ ****************************************************************************/
+
+#include <nuttx/config.h>
+#include <nuttx/fs/ioctl.h>
+#include <errno.h>
+#include <string.h>
+#include <fcntl.h>
+#include "inode/inode.h"
+#include "encpathfs.h"
+
+int encpathfs_open(FAR struct file *filep, FAR const char *path,
+                  int oflags, mode_t mode)
+{
+  FAR struct encpathfs_mount_s *mount = filep->f_inode->i_private;
+  FAR struct encpathfs_file_s *priv;
+  FAR char *physical = NULL;
+  struct stat st;
+  int ret;
+
+  priv = fs_heap_zalloc(sizeof(*priv));
+  if (priv == NULL)
+    {
+      return -ENOMEM;
+    }
+
+  ret = nxmutex_lock(&mount->lock);
+  if (ret < 0)
+    {
+      fs_heap_free(priv);
+      return ret;
+    }
+
+  ret = encpathfs_path(mount, path, &physical, &priv->logical);
+  if (ret < 0)
+    {
+      goto out;
+    }
+
+  ret = mount->lower->u.i_mops->stat(mount->lower, physical, &st);
+  if (ret >= 0 && S_ISDIR(st.st_mode))
+    {
+      ret = -EISDIR;
+      goto out;
+    }
+
+  if (ret < 0 && ret != -ENOENT)
+    {
+      goto out;
+    }
+
+  priv->lower.f_inode = mount->lower;
+  priv->lower.f_oflags = oflags;
+  ret = mount->lower->u.i_mops->open(&priv->lower, physical, oflags, mode);
+  if (ret >= 0)
+    {
+      priv->mount = mount;
+      priv->next = mount->head;
+      mount->head = priv;
+      mount->files++;
+      filep->f_priv = priv;
+      filep->f_pos = priv->lower.f_pos;
+    }
+
+out:
+  fs_heap_free(physical);
+  nxmutex_unlock(&mount->lock);
+  if (ret < 0)
+    {
+      fs_heap_free(priv->logical);
+      fs_heap_free(priv);
+    }
+
+  return ret;
+}
+
+int encpathfs_close(FAR struct file *filep)
+{
+  FAR struct encpathfs_file_s *priv = filep->f_priv;
+  FAR struct encpathfs_mount_s *mount = priv->mount;
+  FAR struct encpathfs_file_s **link;
+  int ret;
+
+  ret = nxmutex_lock(&mount->lock);
+  if (ret < 0)
+    {
+      return ret;
+    }
+
+  ret = mount->lower->u.i_mops->close(&priv->lower);
+  mount->files--;
+  if (ret < 0)
+    {
+      /* VFS consumes the file object even on close failure, but retains
+       * its inode reference.  Keep both that reference and the lower
+       * handle for a subsequent syncfs/unbind retry.
+       */
+
+      priv->orphan_inode = filep->f_inode;
+      filep->f_priv = NULL;
+      nxmutex_unlock(&mount->lock);
+      return ret;
+    }
+
+  for (link = &mount->head; *link != priv; link = &(*link)->next)
+    {
+    }
+
+  *link = priv->next;
+  nxmutex_unlock(&mount->lock);
+  fs_heap_free(priv->logical);
+  fs_heap_free(priv);
+  filep->f_priv = NULL;
+  return ret;
+}
+
+ssize_t encpathfs_read(FAR struct file *filep, FAR char *buffer,
+                      size_t length)
+{
+  FAR struct encpathfs_file_s *priv = filep->f_priv;
+  FAR struct encpathfs_mount_s *mount = priv->mount;
+  ssize_t ret = nxmutex_lock(&mount->lock);
+
+  if (ret >= 0)
+    {
+      ret = mount->lower->u.i_mops->read(&priv->lower, buffer, length);
+      filep->f_pos = priv->lower.f_pos;
+      nxmutex_unlock(&mount->lock);
+    }
+
+  return ret;
+}
+
+ssize_t encpathfs_write(FAR struct file *filep, FAR const char *buffer,
+                       size_t length)
+{
+  FAR struct encpathfs_file_s *priv = filep->f_priv;
+  FAR struct encpathfs_mount_s *mount = priv->mount;
+  ssize_t ret = nxmutex_lock(&mount->lock);
+
+  if (ret >= 0)
+    {
+      ret = mount->lower->u.i_mops->write(&priv->lower, buffer, length);
+      filep->f_pos = priv->lower.f_pos;
+      nxmutex_unlock(&mount->lock);
+    }
+
+  return ret;
+}
+
+off_t encpathfs_seek(FAR struct file *filep, off_t offset, int whence)
+{
+  FAR struct encpathfs_file_s *priv = filep->f_priv;
+  FAR struct encpathfs_mount_s *mount = priv->mount;
+  off_t ret = nxmutex_lock(&mount->lock);
+
+  if (ret >= 0)
+    {
+      if (mount->lower->u.i_mops->seek == NULL)
+        {
+          ret = -ENOSYS;
+        }
+      else
+        {
+          ret = mount->lower->u.i_mops->seek(&priv->lower, offset, whence);
+          filep->f_pos = priv->lower.f_pos;
+        }
+
+      nxmutex_unlock(&mount->lock);
+    }
+
+  return ret;
+}
+
+int encpathfs_ioctl(FAR struct file *filep, int cmd, unsigned long arg)
+{
+  FAR struct encpathfs_file_s *priv = filep->f_priv;
+  FAR char *buffer = (FAR char *)(uintptr_t)arg;
+  size_t length;
+  size_t plen;
+  int ret;
+
+  if (cmd != FIOC_FILEPATH)
+    {
+      return -ENOTTY;
+    }
+
+  if (buffer == NULL)
+    {
+      return -EINVAL;
+    }
+
+  /* Return the upper path only.  The lower FILEPATH ioctl would expose the
+   * hidden namespace, and other lower ioctls could alter the block device.
+   */
+
+  ret = inode_getpath(filep->f_inode, buffer, PATH_MAX);
+  if (ret < 0)
+    {
+      return ret;
+    }
+
+  length = strlen(buffer);
+  plen = strlen(priv->logical);
+  if (length + (length == 0 || buffer[length - 1] != '/') + plen >= PATH_MAX)
+    {
+      return -ENAMETOOLONG;
+    }
+
+  if (length == 0 || buffer[length - 1] != '/')
+    {
+      buffer[length++] = '/';
+    }
+  memcpy(buffer + length, priv->logical, plen + 1);
+  return 0;
+}
+
+int encpathfs_sync(FAR struct file *filep)
+{
+  FAR struct encpathfs_file_s *priv = filep->f_priv;
+  FAR struct encpathfs_mount_s *mount = priv->mount;
+  int ret = nxmutex_lock(&mount->lock);
+
+  if (ret >= 0)
+    {
+      ret = mount->lower->u.i_mops->sync(&priv->lower);
+      nxmutex_unlock(&mount->lock);
+    }
+
+  return ret;
+}
+
+int encpathfs_dup(FAR const struct file *oldp, FAR struct file *newp)
+{
+  FAR struct encpathfs_file_s *oldpriv = oldp->f_priv;
+  FAR struct encpathfs_mount_s *mount = oldpriv->mount;
+  FAR struct encpathfs_file_s *priv;
+  int ret;
+
+  if (mount->lower->u.i_mops->dup == NULL)
+    {
+      return -ENOSYS;
+    }
+
+  priv = fs_heap_zalloc(sizeof(*priv));
+  if (priv == NULL)
+    {
+      return -ENOMEM;
+    }
+
+  priv->logical = fs_heap_strdup(oldpriv->logical);
+  if (priv->logical == NULL)
+    {
+      fs_heap_free(priv);
+      return -ENOMEM;
+    }
+
+  ret = nxmutex_lock(&mount->lock);
+  if (ret >= 0)
+    {
+      priv->lower.f_inode = mount->lower;
+      priv->lower.f_oflags = newp->f_oflags;
+      priv->lower.f_pos = oldpriv->lower.f_pos;
+      ret = mount->lower->u.i_mops->dup(&oldpriv->lower, &priv->lower);
+      if (ret >= 0)
+        {
+          priv->mount = mount;
+          priv->next = mount->head;
+          mount->head = priv;
+          mount->files++;
+          newp->f_priv = priv;
+          newp->f_pos = priv->lower.f_pos;
+        }
+
+      nxmutex_unlock(&mount->lock);
+    }
+
+  if (ret < 0)
+    {
+      fs_heap_free(priv->logical);
+      fs_heap_free(priv);
+    }
+
+  return ret;
+}
+
+int encpathfs_fstat(FAR const struct file *filep, FAR struct stat *buf)
+{
+  FAR struct encpathfs_file_s *priv = filep->f_priv;
+  FAR struct encpathfs_mount_s *mount = priv->mount;
+  int ret = nxmutex_lock(&mount->lock);
+
+  if (ret >= 0)
+    {
+      ret = mount->lower->u.i_mops->fstat == NULL ? -ENOSYS :
+            mount->lower->u.i_mops->fstat(&priv->lower, buf);
+      nxmutex_unlock(&mount->lock);
+    }
+
+  return ret;
+}
+
+int encpathfs_fchstat(FAR const struct file *filep,
+                     FAR const struct stat *buf, int flags)
+{
+  FAR struct encpathfs_file_s *priv = filep->f_priv;
+  FAR struct encpathfs_mount_s *mount = priv->mount;
+  int ret = nxmutex_lock(&mount->lock);
+
+  if (ret >= 0)
+    {
+      ret = mount->lower->u.i_mops->fchstat == NULL ? -ENOSYS :
+            mount->lower->u.i_mops->fchstat(&priv->lower, buf, flags);
+      nxmutex_unlock(&mount->lock);
+    }
+
+  return ret;
+}
+
+int encpathfs_truncate(FAR struct file *filep, off_t length)
+{
+  FAR struct encpathfs_file_s *priv = filep->f_priv;
+  FAR struct encpathfs_mount_s *mount = priv->mount;
+  int ret = nxmutex_lock(&mount->lock);
+
+  if (ret >= 0)
+    {
+      if (length < 0)
+        {
+          ret = -EINVAL;
+        }
+      else
+        {
+          ret = mount->lower->u.i_mops->truncate == NULL ? -ENOSYS :
+                mount->lower->u.i_mops->truncate(&priv->lower, length);
+          filep->f_pos = priv->lower.f_pos;
+        }
+
+      nxmutex_unlock(&mount->lock);
+    }
+
+  return ret;
+}
diff --git a/fs/encpathfs/encpathfs_mount.c b/fs/encpathfs/encpathfs_mount.c
new file mode 100644
index 0000000000000000000000000000000000000000..9fa3e804a0be5e31b04e2e3a140e3e10d6ba811e
--- /dev/null
+++ b/fs/encpathfs/encpathfs_mount.c
@@ -0,0 +1,950 @@
+/****************************************************************************
+ * fs/encpathfs/encpathfs_mount.c
+ *
+ * SPDX-License-Identifier: Apache-2.0
+ ****************************************************************************/
+
+#include <nuttx/config.h>
+#include <nuttx/atomic.h>
+#include <nuttx/crypto/aes_siv.h>
+#include <sys/mount.h>
+#include <errno.h>
+#include <fcntl.h>
+#include <string.h>
+#include "inode/inode.h"
+#include "vfs/vfs.h"
+#include "encpathfs.h"
+
+static mutex_t g_keylock = NXMUTEX_INITIALIZER;
+static uint8_t g_key[ENCPATHFS_KEY_SIZE];
+static bool g_keyvalid;
+static bool g_busy;
+
+struct encpathfs_pending_s
+{
+  struct file filep;
+  FAR struct fs_dirent_s *dir;
+  bool closed;
+  bool remove_meta;
+  bool remove_root;
+};
+
+static FAR struct encpathfs_pending_s *g_pending;
+static bool g_pending_ready;
+
+#ifdef CONFIG_FS_FATFS
+extern const struct mountpt_operations g_fatfs_operations;
+#endif
+
+static const uint8_t g_header[16] =
+{
+  'E', 'N', 'C', 'P', 'F', 'S', '0', '1',
+  1, 0, 1, 0, ENCPATHFS_NAME_MAX, 0, 0, 0
+};
+
+static const uint8_t g_volume_ad[] = "encpathfs:volume:v1";
+static const uint8_t g_check[] = "encpathfs-volume-v1";
+
+#define META_SIZE (sizeof(g_header) + 16 + sizeof(g_check) - 1)
+
+static int encpathfs_mmap(FAR struct file *filep,
+                         FAR struct mm_map_entry_s *entry)
+{
+  /* NULL or -ENOTTY would allow VFS to fall back to a RAM mapping in
+   * configurations enabling RAMMAP.  Version one explicitly rejects it.
+   */
+
+  return -ENOSYS;
+}
+
+const struct mountpt_operations g_encpathfs_operations =
+{
+  .open      = encpathfs_open,
+  .close     = encpathfs_close,
+  .read      = encpathfs_read,
+  .write     = encpathfs_write,
+  .seek      = encpathfs_seek,
+  .ioctl     = encpathfs_ioctl,
+  .mmap      = encpathfs_mmap,
+  .truncate  = encpathfs_truncate,
+  .sync      = encpathfs_sync,
+  .dup       = encpathfs_dup,
+  .fstat     = encpathfs_fstat,
+  .fchstat   = encpathfs_fchstat,
+  .opendir   = encpathfs_opendir,
+  .closedir  = encpathfs_closedir,
+  .readdir   = encpathfs_readdir,
+  .rewinddir = encpathfs_rewinddir,
+  .bind      = encpathfs_bind,
+  .unbind    = encpathfs_unbind,
+  .statfs    = encpathfs_statfs,
+  .unlink    = encpathfs_unlink,
+  .mkdir     = encpathfs_mkdir,
+  .rmdir     = encpathfs_rmdir,
+  .rename    = encpathfs_rename,
+  .stat      = encpathfs_stat,
+  .chstat    = encpathfs_chstat,
+  .syncfs    = encpathfs_syncfs,
+  .flags     = MOUNTPT_RENAME_OWN_TARGET
+};
+
+static void encpathfs_idle(void)
+{
+  nxmutex_lock(&g_keylock);
+  /* An operation that failed to close its temporary metadata handle still
+   * owns a lower reference.  Only recover may release that state.
+   */
+
+  g_busy = g_pending != NULL;
+  g_pending_ready = g_pending != NULL;
+  nxmutex_unlock(&g_keylock);
+}
+
+int encpathfs_setkey(unsigned int slot, FAR const uint8_t *key,
+                    size_t keylen)
+{
+  int ret;
+
+  if (slot != 0 || key == NULL || keylen != ENCPATHFS_KEY_SIZE)
+    {
+      return -EINVAL;
+    }
+
+  ret = nxmutex_lock(&g_keylock);
+  if (ret < 0)
+    {
+      return ret;
+    }
+
+  if (g_busy)
+    {
+      ret = -EBUSY;
+    }
+  else
+    {
+      encpathfs_erase(g_key, sizeof(g_key));
+      memcpy(g_key, key, sizeof(g_key));
+      g_keyvalid = true;
+      ret = 0;
+    }
+
+  nxmutex_unlock(&g_keylock);
+  return ret;
+}
+
+int encpathfs_clearkey(unsigned int slot)
+{
+  int ret;
+
+  if (slot != 0)
+    {
+      return -EINVAL;
+    }
+
+  ret = nxmutex_lock(&g_keylock);
+  if (ret < 0)
+    {
+      return ret;
+    }
+
+  if (g_busy)
+    {
+      ret = -EBUSY;
+    }
+  else
+    {
+      encpathfs_erase(g_key, sizeof(g_key));
+      g_keyvalid = false;
+      ret = 0;
+    }
+
+  nxmutex_unlock(&g_keylock);
+  return ret;
+}
+
+/* Called with the inode tree locked.  A mounted lower has one namespace
+ * reference.  Reject pre-existing lower handles before taking ownership.
+ */
+
+static int encpathfs_getlower(FAR const char *path,
+                             FAR struct inode **result)
+{
+  struct inode_search_s search;
+  FAR const struct mountpt_operations *ops;
+  FAR struct inode *node;
+  int ret;
+
+  /* Do not resolve a terminal soft link: inode_remove uses nofollow for
+   * its terminal component too.  Verifying one inode and detaching an
+   * alias would otherwise leave the verified lower publicly accessible.
+   */
+
+  SETUP_SEARCH(&search, path, true);
+  ret = inode_search(&search);
+  if (ret < 0)
+    {
+      RELEASE_SEARCH(&search);
+      return ret;
+    }
+
+  node = search.node;
+  if (!INODE_IS_MOUNTPT(node) || search.relpath[0] != '\0' ||
+      node->i_child != NULL)
+    {
+      ret = -EINVAL;
+      goto out;
+    }
+
+  if (atomic_read(&node->i_crefs) != 1 || INODE_IS_PATHCACHE(node))
+    {
+      ret = -EBUSY;
+      goto out;
+    }
+
+  ops = node->u.i_mops;
+#ifdef CONFIG_FS_FATFS
+  /* Version one is a FAT proxy.  In particular, lower symlinks must not
+   * redirect encoded components out of the authenticated .p directory.
+   */
+
+  if (ops != &g_fatfs_operations)
+    {
+      ret = -ENOTSUP;
+      goto out;
+    }
+#else
+  ret = -ENOTSUP;
+  goto out;
+#endif
+
+  if (ops == &g_encpathfs_operations || ops->open == NULL ||
+      ops->close == NULL || ops->read == NULL || ops->write == NULL ||
+      ops->sync == NULL || ops->syncfs == NULL || ops->stat == NULL ||
+      ops->opendir == NULL || ops->closedir == NULL ||
+      ops->readdir == NULL || ops->rewinddir == NULL ||
+      ops->mkdir == NULL || ops->rmdir == NULL || ops->unlink == NULL ||
+      ops->rename == NULL || ops->unbind == NULL || ops->statfs == NULL)
+    {
+      ret = -ENOTSUP;
+      goto out;
+    }
+
+  inode_addref(node);
+  *result = node;
+  ret = 0;
+out:
+  RELEASE_SEARCH(&search);
+  return ret;
+}
+
+static int encpathfs_meta(FAR struct inode *lower, FAR const uint8_t *key,
+                         bool create)
+{
+  FAR const struct mountpt_operations *ops = lower->u.i_mops;
+  FAR struct encpathfs_pending_s *pending;
+  FAR struct file *filep;
+  uint8_t record[META_SIZE];
+  uint8_t ad[sizeof(g_volume_ad) - 1 + sizeof(g_header)];
+  uint8_t plain[sizeof(g_check) - 1];
+  struct stat st;
+  size_t offset;
+  ssize_t count;
+  int close_ret;
+  int ret;
+
+  pending = fs_heap_zalloc(sizeof(*pending));
+  if (pending == NULL)
+    {
+      return -ENOMEM;
+    }
+
+  filep = &pending->filep;
+  memset(record, 0, sizeof(record));
+  memcpy(ad, g_volume_ad, sizeof(g_volume_ad) - 1);
+  memcpy(ad + sizeof(g_volume_ad) - 1, g_header, sizeof(g_header));
+  filep->f_inode = lower;
+  filep->f_oflags = create ? O_WRONLY | O_CREAT | O_EXCL : O_RDONLY;
+  if (!create)
+    {
+      ret = ops->stat(lower, ENCPATHFS_META, &st);
+      if (ret < 0)
+        {
+          goto out;
+        }
+
+      if (!S_ISREG(st.st_mode) || st.st_size != META_SIZE)
+        {
+          ret = -EINVAL;
+          goto out;
+        }
+    }
+  else
+    {
+      memcpy(record, g_header, sizeof(g_header));
+      ret = aes_siv_encrypt(key, ad, sizeof(ad), g_check,
+                            sizeof(g_check) - 1,
+                            record + sizeof(g_header));
+      if (ret < 0)
+        {
+          goto out;
+        }
+    }
+
+  ret = ops->open(filep, ENCPATHFS_META, filep->f_oflags, 0600);
+  if (ret < 0)
+    {
+      goto out;
+    }
+
+  for (offset = 0; offset < sizeof(record); offset += count)
+    {
+      if (create)
+        {
+          count = ops->write(filep, (FAR const char *)record + offset,
+                             sizeof(record) - offset);
+        }
+      else
+        {
+          count = ops->read(filep, (FAR char *)record + offset,
+                            sizeof(record) - offset);
+        }
+
+      if (count <= 0 || count > sizeof(record) - offset)
+        {
+          ret = count < 0 ? (int)count : -EIO;
+          goto close;
+        }
+    }
+
+  if (create)
+    {
+      ret = ops->sync(filep);
+    }
+  else if (memcmp(record, g_header, sizeof(g_header)) != 0)
+    {
+      ret = -EPROTONOSUPPORT;
+    }
+  else
+    {
+      ret = aes_siv_decrypt(key, ad, sizeof(ad),
+                            record + sizeof(g_header),
+                            sizeof(record) - sizeof(g_header), plain);
+      if (ret >= 0 && memcmp(plain, g_check, sizeof(plain)) != 0)
+        {
+          ret = -EBADMSG;
+        }
+    }
+
+close:
+  close_ret = ops->close(filep);
+  if (close_ret < 0)
+    {
+      /* FatFs retains FIL when close fails.  Do not lose the handle or
+       * its mount reference: the manager retries recover before lower
+       * unmount and keeps its block resource flags if cleanup still fails.
+       */
+
+      pending->remove_meta = create;
+      inode_addref(lower);
+      nxmutex_lock(&g_keylock);
+      g_pending = pending;
+      g_pending_ready = false;
+      nxmutex_unlock(&g_keylock);
+      pending = NULL;
+    }
+
+  if (ret >= 0)
+    {
+      ret = close_ret;
+    }
+
+out:
+  fs_heap_free(pending);
+  encpathfs_erase(record, sizeof(record));
+  encpathfs_erase(ad, sizeof(ad));
+  encpathfs_erase(plain, sizeof(plain));
+  return ret;
+}
+
+int encpathfs_recover(void)
+{
+  FAR struct encpathfs_pending_s *pending;
+  FAR struct inode *lower;
+  FAR const struct mountpt_operations *ops;
+  int ret = nxmutex_lock(&g_keylock);
+
+  if (ret < 0)
+    {
+      return ret;
+    }
+
+  pending = g_pending;
+  if (pending == NULL || !g_pending_ready)
+    {
+      ret = pending == NULL ? 0 : -EBUSY;
+      nxmutex_unlock(&g_keylock);
+      return ret;
+    }
+
+  g_pending_ready = false;
+  nxmutex_unlock(&g_keylock);
+  lower = pending->filep.f_inode;
+  ops = lower->u.i_mops;
+  inode_lock();
+  ret = 0;
+  if (!pending->closed)
+    {
+      if (pending->dir != NULL)
+        {
+          ret = ops->closedir(lower, pending->dir);
+        }
+      else
+        {
+          ret = ops->close(&pending->filep);
+        }
+
+      if (ret >= 0)
+        {
+          pending->closed = true;
+        }
+    }
+
+  if (ret >= 0 && pending->remove_meta)
+    {
+      ret = ops->unlink(lower, ENCPATHFS_META);
+      if (ret == -ENOENT)
+        {
+          ret = 0;
+        }
+
+      if (ret >= 0)
+        {
+          pending->remove_meta = false;
+        }
+    }
+
+  if (ret >= 0 && pending->remove_root)
+    {
+      ret = ops->rmdir(lower, ENCPATHFS_ROOT);
+      if (ret == -ENOENT)
+        {
+          ret = 0;
+        }
+
+      if (ret >= 0)
+        {
+          pending->remove_root = false;
+        }
+    }
+
+  if (ret >= 0)
+    {
+      ret = ops->syncfs(lower);
+    }
+
+  if (ret >= 0)
+    {
+      inode_release(lower);
+    }
+
+  inode_unlock();
+  nxmutex_lock(&g_keylock);
+  if (ret >= 0)
+    {
+      g_pending = NULL;
+      g_busy = false;
+      fs_heap_free(pending);
+    }
+  else
+    {
+      g_pending_ready = true;
+    }
+
+  nxmutex_unlock(&g_keylock);
+  return ret;
+}
+
+int encpathfs_initialize(FAR const char *path, FAR const uint8_t *key,
+                        size_t keylen)
+{
+  FAR struct inode *lower = NULL;
+  FAR struct encpathfs_pending_s *pending_dir = NULL;
+  FAR struct fs_dirent_s *dir;
+  FAR const struct mountpt_operations *ops;
+  struct dirent entry;
+  bool root_created = false;
+  bool meta_created = false;
+  int tmp;
+  int ret;
+
+  if (path == NULL || path[0] != '/' || key == NULL ||
+      keylen != ENCPATHFS_KEY_SIZE)
+    {
+      return -EINVAL;
+    }
+
+  ret = nxmutex_lock(&g_keylock);
+  if (ret < 0)
+    {
+      return ret;
+    }
+
+  if (g_busy)
+    {
+      nxmutex_unlock(&g_keylock);
+      return -EBUSY;
+    }
+
+  g_busy = true;
+  nxmutex_unlock(&g_keylock);
+  inode_lock();
+  ret = encpathfs_getlower(path, &lower);
+  if (ret < 0)
+    {
+      goto out;
+    }
+
+  ops = lower->u.i_mops;
+  pending_dir = fs_heap_zalloc(sizeof(*pending_dir));
+  if (pending_dir == NULL)
+    {
+      ret = -ENOMEM;
+      goto out;
+    }
+
+  ret = ops->opendir(lower, "", &dir);
+  if (ret < 0)
+    {
+      goto out;
+    }
+
+  /* Provisioning only accepts an empty volume.  Existing data, including an
+   * incomplete or corrupt previous header, is never silently overwritten.
+   */
+
+  do
+    {
+      ret = ops->readdir(lower, dir, &entry);
+    }
+  while (ret >= 0 && (!strcmp(entry.d_name, ".") ||
+                      !strcmp(entry.d_name, "..")));
+
+  tmp = ops->closedir(lower, dir);
+  if (tmp < 0)
+    {
+      /* The initialization scan owns a DIR too.  A failed closedir must
+       * be recoverable just like a failed metadata FIL close.
+       */
+
+      pending_dir->filep.f_inode = lower;
+      pending_dir->dir = dir;
+      inode_addref(lower);
+      nxmutex_lock(&g_keylock);
+      g_pending = pending_dir;
+      g_pending_ready = false;
+      nxmutex_unlock(&g_keylock);
+      pending_dir = NULL;
+    }
+
+  if (ret >= 0)
+    {
+      ret = -EEXIST;
+      goto out;
+    }
+
+  if (ret != -ENOENT || tmp < 0)
+    {
+      ret = tmp < 0 ? tmp : ret;
+      goto out;
+    }
+
+  ret = ops->mkdir(lower, ENCPATHFS_ROOT, 0700);
+  if (ret < 0)
+    {
+      goto out;
+    }
+
+  root_created = true;
+  ret = encpathfs_meta(lower, key, true);
+  if (ret < 0)
+    {
+      /* Since the volume was empty under the inode lock, any header now
+       * present belongs to this failed initialization attempt.
+       */
+
+      if (g_pending == NULL)
+        {
+          ops->unlink(lower, ENCPATHFS_META);
+        }
+      goto out;
+    }
+
+  meta_created = true;
+  ret = ops->syncfs(lower);
+  if (ret >= 0)
+    {
+      ret = encpathfs_meta(lower, key, false);
+    }
+
+out:
+  fs_heap_free(pending_dir);
+  if (ret < 0 && lower != NULL)
+    {
+      if (g_pending != NULL)
+        {
+          /* Keep newly created entries until the pending FIL can close.
+           * Removing an open FAT entry would invalidate recovery state.
+           */
+
+          g_pending->remove_meta = root_created;
+          g_pending->remove_root = root_created;
+        }
+      else if (meta_created)
+        {
+          lower->u.i_mops->unlink(lower, ENCPATHFS_META);
+        }
+
+      if (root_created && g_pending == NULL)
+        {
+          lower->u.i_mops->rmdir(lower, ENCPATHFS_ROOT);
+        }
+
+      lower->u.i_mops->syncfs(lower);
+    }
+
+  if (lower != NULL)
+    {
+      inode_release(lower);
+    }
+
+  inode_unlock();
+  encpathfs_idle();
+  return ret;
+}
+
+int encpathfs_bind(FAR struct inode *blkdriver, FAR const void *data,
+                  FAR void **handle)
+{
+  FAR struct encpathfs_mount_s *mount;
+  FAR const char *options = data;
+  FAR const char *suffix;
+  FAR char *path = NULL;
+  struct stat st;
+  struct statfs statfs;
+  size_t length;
+  int ret;
+
+  mount = fs_heap_zalloc(sizeof(*mount));
+  if (mount == NULL)
+    {
+      encpathfs_clearkey(0);
+      return -ENOMEM;
+    }
+
+  ret = nxmutex_lock(&g_keylock);
+  if (ret < 0)
+    {
+      fs_heap_free(mount);
+      return ret;
+    }
+
+  if (g_busy || !g_keyvalid)
+    {
+      ret = g_busy ? -EBUSY : -ENOKEY;
+      nxmutex_unlock(&g_keylock);
+      fs_heap_free(mount);
+      return ret;
+    }
+
+  memcpy(mount->key, g_key, sizeof(g_key));
+  encpathfs_erase(g_key, sizeof(g_key));
+  g_keyvalid = false;
+  g_busy = true;
+  nxmutex_unlock(&g_keylock);
+  nxmutex_init(&mount->lock);
+
+  if (blkdriver != NULL || options == NULL || handle == NULL ||
+      strnlen(options, PATH_MAX + 32) >= PATH_MAX + 32 ||
+      strncmp(options, "lower=/", 7) != 0)
+    {
+      ret = -EINVAL;
+      goto fail;
+    }
+
+  suffix = strchr(options + 6, ',');
+  if (suffix == NULL || strcmp(suffix, ",root=.p,slot=0") != 0)
+    {
+      ret = -EINVAL;
+      goto fail;
+    }
+
+  length = suffix - (options + 6);
+  if (length < 2 || length >= PATH_MAX)
+    {
+      ret = -EINVAL;
+      goto fail;
+    }
+
+  path = fs_heap_strndup(options + 6, length);
+  if (path == NULL)
+    {
+      ret = -ENOMEM;
+      goto fail;
+    }
+
+  inode_lock();
+  ret = encpathfs_getlower(path, &mount->lower);
+  if (ret < 0)
+    {
+      goto unlock;
+    }
+
+  ret = mount->lower->u.i_mops->statfs(mount->lower, &statfs);
+  if (ret >= 0 && statfs.f_namelen < ENCPATHFS_ENCODED_MAX)
+    {
+      ret = -ENAMETOOLONG;
+    }
+
+  if (ret >= 0)
+    {
+      ret = mount->lower->u.i_mops->stat(mount->lower,
+                                        ENCPATHFS_ROOT, &st);
+    }
+
+  if (ret >= 0 && !S_ISDIR(st.st_mode))
+    {
+      ret = -ENOTDIR;
+    }
+
+  if (ret >= 0)
+    {
+      ret = encpathfs_meta(mount->lower, mount->key, false);
+    }
+
+  if (ret >= 0)
+    {
+      /* inode_remove returns -EBUSY on successful detach because the
+       * reference obtained above intentionally keeps the inode alive.
+       */
+
+      ret = inode_remove(path);
+      if (ret == -EBUSY)
+        {
+          ret = 0;
+        }
+    }
+
+unlock:
+  inode_unlock();
+  fs_heap_free(path);
+  path = NULL;
+  if (ret >= 0)
+    {
+      *handle = mount;
+      return 0;
+    }
+
+fail:
+  fs_heap_free(path);
+  if (mount->lower != NULL)
+    {
+      inode_release(mount->lower);
+    }
+
+  nxmutex_destroy(&mount->lock);
+  encpathfs_erase(mount->key, sizeof(mount->key));
+  fs_heap_free(mount);
+  encpathfs_idle();
+  return ret;
+}
+
+int encpathfs_flush(FAR struct encpathfs_mount_s *mount)
+{
+  FAR struct encpathfs_file_s **flink = &mount->head;
+  FAR struct encpathfs_dir_s **dlink = &mount->dhead;
+  FAR struct encpathfs_file_s *filep;
+  FAR struct encpathfs_dir_s *dir;
+  int ret;
+
+  while ((filep = *flink) != NULL)
+    {
+      if (filep->orphan_inode != NULL)
+        {
+          ret = mount->lower->u.i_mops->close(&filep->lower);
+        }
+      else
+        {
+          ret = mount->lower->u.i_mops->sync(&filep->lower);
+        }
+
+      if (ret < 0)
+        {
+          return ret;
+        }
+
+      if (filep->orphan_inode != NULL)
+        {
+          *flink = filep->next;
+          inode_release(filep->orphan_inode);
+          fs_heap_free(filep->logical);
+          fs_heap_free(filep);
+        }
+      else
+        {
+          flink = &filep->next;
+        }
+    }
+
+  while ((dir = *dlink) != NULL)
+    {
+      if (dir->orphan)
+        {
+          ret = mount->lower->u.i_mops->closedir(mount->lower, dir->lower);
+          if (ret < 0)
+            {
+              return ret;
+            }
+
+          *dlink = dir->next;
+          fs_heap_free(dir);
+        }
+      else
+        {
+          dlink = &dir->next;
+        }
+    }
+
+  return mount->lower->u.i_mops->syncfs(mount->lower);
+}
+
+struct encpathfs_upper_s
+{
+  FAR struct encpathfs_mount_s *mount;
+  FAR struct inode *inode;
+};
+
+static int encpathfs_findupper(FAR struct inode *inode,
+                              FAR char *path, FAR void *arg)
+{
+  FAR struct encpathfs_upper_s *upper = arg;
+
+  if (INODE_IS_MOUNTPT(inode) &&
+      inode->u.i_mops == &g_encpathfs_operations &&
+      inode->i_private == upper->mount)
+    {
+      upper->inode = inode;
+      return 1;
+    }
+
+  return 0;
+}
+
+int encpathfs_unbind(FAR void *handle, FAR struct inode **blkdriver,
+                    unsigned int flags)
+{
+  FAR struct encpathfs_mount_s *mount = handle;
+  FAR struct inode *driver = NULL;
+  struct encpathfs_upper_s upper = { mount, NULL };
+  int ret = nxmutex_lock(&mount->lock);
+
+  if (ret < 0)
+    {
+      return ret;
+    }
+
+  /* Forced detach is intentionally unsupported: no caller can revoke
+   * live file objects or their encryption keys.
+   */
+
+  if (mount->files != 0 || mount->dirs != 0)
+    {
+      nxmutex_unlock(&mount->lock);
+      return -EBUSY;
+    }
+
+  ret = encpathfs_flush(mount);
+  if (ret >= 0)
+    {
+      /* VFS holds the inode tree write lock during unbind.  In addition
+       * to completed opens, protect operations which found the upper inode
+       * but have not entered a callback yet.  A published mount has one
+       * namespace reference and nx_umount2 holds one lookup reference.
+       * No upper exists when VFS is rolling back an unpublished bind.
+       */
+
+      ret = foreach_inode(encpathfs_findupper, &upper);
+      if (ret > 0)
+        {
+          ret = 0;
+        }
+
+      if (ret >= 0 && upper.inode != NULL &&
+          atomic_read(&upper.inode->i_crefs) > 2)
+        {
+          ret = -EBUSY;
+        }
+    }
+
+  if (ret >= 0)
+    {
+      ret = mount->lower->u.i_mops->unbind(mount->lower->i_private,
+                                           &driver, 0);
+    }
+
+  if (ret != 0)
+    {
+      nxmutex_unlock(&mount->lock);
+      return ret > 0 ? -EBUSY : ret;
+    }
+
+  mount->lower->i_private = NULL;
+  inode_release(mount->lower);
+  if (blkdriver != NULL)
+    {
+      *blkdriver = driver;
+    }
+  else if (driver != NULL)
+    {
+      inode_release(driver);
+    }
+
+  encpathfs_erase(mount->key, sizeof(mount->key));
+  nxmutex_unlock(&mount->lock);
+  nxmutex_destroy(&mount->lock);
+  fs_heap_free(mount);
+  encpathfs_idle();
+  return 0;
+}
+
+int encpathfs_statfs(FAR struct inode *inode, FAR struct statfs *buf)
+{
+  FAR struct encpathfs_mount_s *mount = inode->i_private;
+  int ret = nxmutex_lock(&mount->lock);
+
+  if (ret >= 0)
+    {
+      ret = mount->lower->u.i_mops->statfs(mount->lower, buf);
+      if (ret >= 0)
+        {
+          buf->f_namelen = ENCPATHFS_NAME_MAX;
+        }
+
+      nxmutex_unlock(&mount->lock);
+    }
+
+  return ret;
+}
+
+int encpathfs_syncfs(FAR struct inode *inode)
+{
+  FAR struct encpathfs_mount_s *mount = inode->i_private;
+  int ret = nxmutex_lock(&mount->lock);
+
+  if (ret >= 0)
+    {
+      ret = encpathfs_flush(mount);
+      nxmutex_unlock(&mount->lock);
+    }
+
+  return ret;
+}
