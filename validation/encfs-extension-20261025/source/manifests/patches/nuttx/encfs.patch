+#!/usr/bin/env python3
+"""Adversarial tests for the actual EncFS keyslot and crypto implementations.
+
+The in-memory provider implements the documented atomic compare/exchange
+contract.  These tests do not model a physical keystore or power-loss media.
+"""
+
+import argparse
+import ctypes as c
+import errno
+import hashlib
+import json
+import os
+import pathlib
+import shutil
+import subprocess
+import tempfile
+
+
+def main():
+    parser = argparse.ArgumentParser(description=__doc__)
+    parser.add_argument("--report", type=pathlib.Path)
+    args = parser.parse_args()
+    root = pathlib.Path(__file__).resolve().parents[3]
+    checks = 0
+
+    def check(condition, message):
+        nonlocal checks
+        assert condition, message
+        checks += 1
+
+    with tempfile.TemporaryDirectory(prefix="encfs-keywrap-review-") as folder:
+        tmp = pathlib.Path(folder)
+        include = tmp / "include"
+        headers = ["crypto/aes.h", "crypto/cmac.h", "crypto/md5.h",
+                   "crypto/sha1.h", "crypto/sha2.h", "crypto/hmac.h",
+                   "nuttx/crypto/aes_siv.h", "nuttx/crypto/hkdf.h",
+                   "nuttx/fs/encfs.h"]
+        for header in headers:
+            target = include / header
+            target.parent.mkdir(parents=True, exist_ok=True)
+            shutil.copyfile(root / "include" / header, target)
+        (include / "nuttx/config.h").write_text(
+            "#define CONFIG_ENCFS_KEYWRAP 1\n"
+            "#define CONFIG_ENCFS_TESTING 1\n"
+            "#define CONFIG_BOARDCTL_UNIQUEKEY_SIZE 32\n")
+        (include / "nuttx/compiler.h").write_text(
+            "#define FAR\n#define CODE\n"
+            "#define swap32(value) __builtin_bswap32(value)\n"
+            "#define swap64(value) __builtin_bswap64(value)\n")
+        (include / "nuttx/board.h").write_text(
+            "int board_uniquekey(unsigned char *key);\n")
+        wrapper = tmp / "wrapper.c"
+        wrapper.write_text(
+            '#include "' + str(root / "fs/encfs/encfs_keywrap.c") + '"\n'
+            'static int board_calls;\n'
+            'int board_uniquekey(unsigned char *key)\n'
+            '{ board_calls++; memset(key, 0x41, 32); return 0; }\n'
+            'int test_board_calls(void) { return board_calls; }\n'
+            'int test_cache_clean(void)\n'
+            '{ size_t i; unsigned char all = 0;\n'
+            '  for (i=0; i<sizeof(g_active_keys); i++)\n'
+            '    all |= ((unsigned char *)&g_active_keys)[i];\n'
+            '  for (i=0; i<sizeof(g_record); i++) all |= g_record[i];\n'
+            '  for (i=0; i<sizeof(g_pending_record); i++)\n'
+            '    all |= g_pending_record[i];\n'
+            '  return all==0 && !g_valid && !g_pending && !g_record_present; }\n'
+            'int test_generation_slot(unsigned char *out)\n'
+            '{ return slot_seal(0, UINT64_MAX, &g_active_keys, out); }\n'
+            'int test_foreign_slot(unsigned char *out)\n'
+            '{ struct encfs_keys_s other = g_active_keys; int ret;\n'
+            '  other.block[0] ^= 1;\n'
+            '  ret = slot_seal(0, 1, &other, out);\n'
+            '  encfs_erase(&other, sizeof(other)); return ret; }\n')
+        sources = [wrapper, root / "fs/encfs/encfs_key.c"]
+        sources += [root / "crypto" / (name + ".c")
+                    for name in ("aes", "cmac", "aes_siv", "hkdf", "hmac",
+                                 "md5", "sha1", "sha2")]
+        inputs = [root / "fs/encfs/encfs_keywrap.c", root / "fs/encfs/encfs.h",
+                  *sources[1:], *[root / "include" / header for header in headers]]
+        hashes = {str(path.relative_to(root)): hashlib.sha256(
+            path.read_bytes()).hexdigest() for path in inputs}
+        library = tmp / "keywrap.so"
+        subprocess.run([
+            "cc", "-shared", "-fPIC", "-O1", "-g", "-Wall", "-Wextra",
+            "-Werror", "-Wno-old-style-declaration", "-fsanitize=undefined",
+            "-fno-sanitize-recover=all",
+            "-include", "stdint.h", "-include", str(include / "nuttx/compiler.h"),
+            "-I", str(include), *map(str, sources), "-o", str(library)], check=True)
