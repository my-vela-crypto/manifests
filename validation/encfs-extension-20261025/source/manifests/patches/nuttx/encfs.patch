diff --git a/fs/encfs/encfs_key.c b/fs/encfs/encfs_key.c
new file mode 100644
index 0000000000000000000000000000000000000000..ba7582c2dcba64c18a4c40ebc60185b5ce14d17e
--- /dev/null
+++ b/fs/encfs/encfs_key.c
@@ -0,0 +1,157 @@
+/****************************************************************************
+ * fs/encfs/encfs_key.c
+ *
+ * SPDX-License-Identifier: Apache-2.0
+ *
+ ****************************************************************************/
+
+/****************************************************************************
+ * Included Files
+ ****************************************************************************/
+
+#include <nuttx/config.h>
+
+#include <errno.h>
+#include <string.h>
+
+#include <nuttx/board.h>
+#include <nuttx/crypto/hkdf.h>
+
+#include "encfs.h"
+
+#if CONFIG_BOARDCTL_UNIQUEKEY_SIZE != ENCFS_MASTER_KEY_SIZE
+#  error "ENCFSMGR requires a 32-byte board unique key"
+#endif
+
+#ifndef CONFIG_ENCFS_KEYWRAP
+int encfs_keys_acquire(bool provision, FAR struct encfs_keys_s *keys,
+                       FAR enum encfs_stage_e *stage)
+{
+  (void)provision;
+  return encfs_derive_keys(keys, stage);
+}
+
+int encfs_keys_commit(void)
+{
+  return 0;
+}
+
+void encfs_keys_forget(void)
+{
+}
+
+void encfs_keys_status(FAR struct encfs_status_s *status)
+{
+  (void)status;
+}
+#endif
+
+/****************************************************************************
+ * Private Data
+ ****************************************************************************/
+
+#ifdef CONFIG_ENCFS_TESTING
+static uint8_t g_test_master[ENCFS_MASTER_KEY_SIZE];
+static bool g_test_provider;
+static bool g_test_missing;
+#endif
+
+/****************************************************************************
+ * Public Functions
+ ****************************************************************************/
+
+/* A volatile store prevents dead-store elimination of temporary secrets. */
+
+void encfs_erase(FAR void *memory, size_t length)
+{
+  FAR volatile uint8_t *p = memory;
+
+  while (length-- > 0)
+    {
+      *p++ = 0;
+    }
+}
+
+static int encfs_read_master(FAR uint8_t *master)
+{
+#ifdef CONFIG_ENCFS_TESTING
+  if (g_test_provider)
+    {
+      if (g_test_missing)
+        {
+          return -ENOKEY;
+        }
+
+      memcpy(master, g_test_master, ENCFS_MASTER_KEY_SIZE);
+      return 0;
+    }
+#endif
+
+  return board_uniquekey(master);
+}
+
+int encfs_derive_keys(FAR struct encfs_keys_s *keys,
+                      FAR enum encfs_stage_e *stage)
+{
+  static const uint8_t blocksalt[] = "blkcrypt";
+  static const uint8_t pathsalt[] = "encpathfs";
+  uint8_t master[ENCFS_MASTER_KEY_SIZE];
+  int ret;
+
+  memset(keys, 0, sizeof(*keys));
+  *stage = ENCFS_STAGE_MASTER;
+  ret = encfs_read_master(master);
+  if (ret < 0)
+    {
+      goto out;
+    }
+
+  *stage = ENCFS_STAGE_DERIVE;
+  ret = hkdf_sha256(master, sizeof(master), blocksalt,
+                    sizeof(blocksalt) - 1, NULL, 0,
+                    keys->block, sizeof(keys->block));
+  if (ret < 0)
+    {
+      goto out;
+    }
+
+  ret = hkdf_sha256(master, sizeof(master), pathsalt,
+                    sizeof(pathsalt) - 1, NULL, 0,
+                    keys->path, sizeof(keys->path));
+out:
+  encfs_erase(master, sizeof(master));
+  if (ret < 0)
+    {
+      encfs_erase(keys, sizeof(*keys));
+    }
+
+  return ret;
+}
+
+#ifdef CONFIG_ENCFS_TESTING
+int encfs_key_set_test_master(FAR const uint8_t *key, size_t keylen)
+{
+  if ((key == NULL && keylen != 0) ||
+      (key != NULL && keylen != ENCFS_MASTER_KEY_SIZE))
+    {
+      return -EINVAL;
+    }
+
+  encfs_erase(g_test_master, sizeof(g_test_master));
+  g_test_provider = true;
+  g_test_missing = key == NULL;
+  if (key != NULL)
+    {
+      memcpy(g_test_master, key, sizeof(g_test_master));
+    }
+
+  return 0;
+}
+
+void encfs_key_use_board(void)
+{
+  encfs_erase(g_test_master, sizeof(g_test_master));
+  g_test_provider = false;
+  g_test_missing = false;
+}
+#endif
diff --git a/fs/encfs/encfs_keyfile.c b/fs/encfs/encfs_keyfile.c
new file mode 100644
index 0000000000000000000000000000000000000000..20a2b39049d21fa8bdd14e3f3a97b5238259d494
--- /dev/null
+++ b/fs/encfs/encfs_keyfile.c
@@ -0,0 +1,493 @@
+/****************************************************************************
+ * fs/encfs/encfs_keyfile.c
+ *
+ * SPDX-License-Identifier: Apache-2.0
+ *
+ * TESTING ONLY. Host secret files model provider key identifiers; they are
+ * not a hardware keystore. The host must not concurrently edit the slot.
+ * fsync + native host/9p rename models process interruption, not real power
+ * loss or malicious-host rollback. No mount-wide VFS behavior is changed.
+ ****************************************************************************/
+
+/****************************************************************************
+ * Included Files
+ ****************************************************************************/
+
+#include <nuttx/config.h>
+
+#include <sys/stat.h>
+#include <errno.h>
+#include <fcntl.h>
+#include <inttypes.h>
+#include <limits.h>
+#include <stdio.h>
+#include <string.h>
+
+#include <nuttx/fs/fs.h>
+#include <nuttx/signal.h>
+
+#include "inode/inode.h"
+#include "encfs.h"
+
+/****************************************************************************
+ * Public Data
+ ****************************************************************************/
+
+#ifdef CONFIG_FS_HOSTFS
+extern const struct mountpt_operations g_hostfs_operations;
+#endif
+#ifdef CONFIG_FS_V9FS
+extern const struct mountpt_operations g_v9fs_operations;
+#endif
+
+/****************************************************************************
+ * Private Data
+ ****************************************************************************/
+
+static char g_directory[PATH_MAX];
+static bool g_fail_commit;
+static unsigned int g_pause_commit;
+
+/****************************************************************************
+ * Private Functions
+ ****************************************************************************/
+
+static bool test_mount(FAR const struct mountpt_operations *ops)
+{
+#ifdef CONFIG_FS_HOSTFS
+  if (ops == &g_hostfs_operations)
+    {
+      return true;
+    }
+
+#endif
+#ifdef CONFIG_FS_V9FS
+  if (ops == &g_v9fs_operations)
+    {
+      return true;
+    }
+#endif
+
+  (void)ops;
+  return false;
+}
+
+/* Called under inode_lock; the selected path must still reside in an
+ * independent host mount rather than the managed encrypted chain.
+ */
+
+static int keyfile_mount(FAR const char *path,
+                         FAR struct inode_search_s *desc)
+{
+  int ret;
+
+  SETUP_SEARCH(desc, path, true);
+  ret = inode_find(desc);
+  if (ret >= 0 &&
+      (!INODE_IS_MOUNTPT(desc->node) ||
+       !test_mount(desc->node->u.i_mops)))
+    {
+      inode_release(desc->node);
+      ret = -ENOTSUP;
+    }
+
+  return ret;
+}
+
+static int keyfile_path(FAR char *path, FAR const char *name)
+{
+  int count = snprintf(path, PATH_MAX, "%s/%s", g_directory, name);
+
+  return count < 0 || count >= PATH_MAX ? -ENAMETOOLONG : 0;
+}
+
+static int read_exact(FAR const char *path, FAR uint8_t *bytes, size_t size)
+{
+  struct inode_search_s desc;
+  struct file file;
+  struct stat statbuf;
+  size_t done = 0;
+  ssize_t count;
+  int close_ret;
+  int ret;
+
+  inode_lock();
+  ret = keyfile_mount(path, &desc);
+  if (ret < 0)
+    {
+      RELEASE_SEARCH(&desc);
+      inode_unlock();
+      return ret;
+    }
+
+  ret = file_open(&file, path, O_RDONLY | O_NOFOLLOW);
+  if (ret >= 0)
+    {
+      ret = file_fstat(&file, &statbuf);
+      if (ret >= 0 && (!S_ISREG(statbuf.st_mode) || statbuf.st_size < 0 ||
+                      (uint64_t)statbuf.st_size != size))
+        {
+          ret = -EBADMSG;
+        }
+
+      while (ret >= 0 && done < size)
+        {
+          count = file_read(&file, bytes + done, size - done);
+          if (count <= 0)
+            {
+              ret = count < 0 ? count : -EIO;
+              break;
+            }
+
+          done += count;
+        }
+
+      close_ret = file_close(&file);
+      if (ret >= 0)
+        {
+          ret = close_ret;
+        }
+    }
+
+  inode_release(desc.node);
+  RELEASE_SEARCH(&desc);
+  inode_unlock();
+  if (ret < 0)
+    {
+      encfs_erase(bytes, size);
+    }
+
+  return ret;
+}
+
+static int keyfile_master(FAR void *context, uint32_t id, FAR uint8_t *key)
+{
+  char path[PATH_MAX];
+  char name[32];
+  int ret;
+
+  (void)context;
+  snprintf(name, sizeof(name), "master-%08" PRIx32 ".bin", id);
+  ret = keyfile_path(path, name);
+  if (ret >= 0)
+    {
+      ret = read_exact(path, key, ENCFS_MASTER_KEY_SIZE);
+    }
+
+  return ret == -ENOENT ? -ENOKEY : ret;
+}
+
+static int keyfile_random(FAR void *context, FAR uint8_t *bytes, size_t size)
+{
+  char path[PATH_MAX];
+  int ret;
+
+  (void)context;
+  ret = keyfile_path(path, "volume-random.bin");
+  if (ret >= 0)
+    {
+      /* The harness generates this one-use fixture using host os.urandom.
+       * Never silently use the guest's potentially unseeded PRNG.
+       */
+
+      inode_lock();
+      ret = read_exact(path, bytes, size);
+      if (ret >= 0)
+        {
+          ret = nx_unlink(path);
+        }
+
+      inode_unlock();
+    }
+
+  if (ret < 0)
+    {
+      encfs_erase(bytes, size);
+    }
+
+  return ret;
+}
+
+static int keyfile_read(FAR void *context, FAR uint8_t *slot)
+{
+  char path[PATH_MAX];
+  int ret = keyfile_path(path, "encfs.keyslot");
+
+  (void)context;
+  return ret < 0 ? ret : read_exact(path, slot, ENCFS_KEYSLOT_SIZE);
+}
+
+/* The .tmp name is reserved exclusively for this provider in a dedicated
+ * private directory. Its old committed slot is checked before this helper.
+ */
+
+static int keyfile_recover(FAR const char *path)
+{
+  struct file file;
+  struct stat statbuf;
+  uint8_t record[ENCFS_KEYSLOT_SIZE];
+  size_t done = 0;
+  ssize_t count;
+  int close_ret;
+  int ret;
+
+  memset(record, 0, sizeof(record));
+  ret = file_open(&file, path, O_RDONLY | O_NOFOLLOW);
+  if (ret < 0)
+    {
+      return ret == -ENOENT ? 0 : ret;
+    }
+
+  ret = file_fstat(&file, &statbuf);
+  if (ret >= 0 && (!S_ISREG(statbuf.st_mode) || statbuf.st_size < 0 ||
+                  statbuf.st_size > ENCFS_KEYSLOT_SIZE))
+    {
+      ret = -EBADMSG;
+    }
+
+  while (ret >= 0 && done < (size_t)statbuf.st_size)
+    {
+      count = file_read(&file, record + done, statbuf.st_size - done);
+      if (count <= 0)
+        {
+          ret = count < 0 ? count : -EIO;
+          break;
+        }
+
+      done += count;
+    }
+
+  close_ret = file_close(&file);
+  if (ret >= 0)
+    {
+      ret = close_ret;
+    }
+
+  if (ret >= 0)
+    {
+      ret = encfs_keys_staging_valid(record, done);
+    }
+
+  if (ret >= 0)
+    {
+      ret = nx_unlink(path);
+    }
+
+  encfs_erase(record, sizeof(record));
+  return ret;
+}
+
+static int keyfile_exchange(FAR void *context, FAR const uint8_t *expected,
+                             FAR const uint8_t *next)
+{
+  struct inode_search_s olddesc;
+  struct inode_search_s newdesc;
+  struct file file;
+  uint8_t current[ENCFS_KEYSLOT_SIZE];
+  char oldpath[PATH_MAX];
+  char newpath[PATH_MAX];
+  size_t done = 0;
+  ssize_t count;
+  bool staged = false;
+  int close_ret;
+  int ret;
+
+  ret = keyfile_path(newpath, "encfs.keyslot");
+  if (ret >= 0)
+    {
+      ret = keyfile_path(oldpath, "encfs.keyslot.tmp");
+    }
+
+  if (ret < 0)
+    {
+      return ret;
+    }
+
+  inode_lock();
+  ret = keyfile_read(context, current);
+  if ((expected == NULL && ret != -ENOENT) ||
+      (expected != NULL &&
+       (ret != 0 || memcmp(expected, current, sizeof(current)) != 0)))
+    {
+      ret = ret < 0 && ret != -ENOENT ? ret : -ESTALE;
+      goto out;
+    }
+
+  ret = keyfile_recover(oldpath);
+  if (ret < 0)
+    {
+      goto out;
+    }
+
+  ret = file_open(&file, oldpath,
+                  O_WRONLY | O_CREAT | O_EXCL | O_NOFOLLOW, 0600);
+  if (ret < 0)
+    {
+      goto out;
+    }
+
+  staged = true;
+  while (done < ENCFS_KEYSLOT_SIZE)
+    {
+      count = file_write(&file, next + done, ENCFS_KEYSLOT_SIZE - done);
+      if (count <= 0)
+        {
+          ret = count < 0 ? count : -EIO;
+          break;
+        }
+
+      done += count;
+    }
+
+  if (ret >= 0)
+    {
+      ret = file_fsync(&file);
+    }
+
+  close_ret = file_close(&file);
+  if (ret >= 0)
+    {
+      ret = close_ret;
+    }
+
+  if (ret < 0)
+    {
+      goto out;
+    }
+
+  ret = read_exact(oldpath, current, sizeof(current));
+  if (ret >= 0 && memcmp(next, current, sizeof(current)) != 0)
+    {
+      ret = -EIO;
+    }
+
+  if (ret < 0)
+    {
+      goto out;
+    }
+
+  if (g_fail_commit)
+    {
+      g_fail_commit = false;
+      ret = -EIO;
+      goto out;
+    }
+
+  if (g_pause_commit != 0)
+    {
+      unsigned int milliseconds = g_pause_commit;
+
+      g_pause_commit = 0;
+      printf("ENCFS_KEYSLOT_PAUSED before_atomic_commit ms=%u\n",
+             milliseconds);
+      fflush(stdout);
+      nxsig_usleep(milliseconds * 1000);
+    }
+
+  ret = keyfile_mount(oldpath, &olddesc);
+  if (ret >= 0)
+    {
+      ret = keyfile_mount(newpath, &newdesc);
+      if (ret >= 0)
+        {
+          if (olddesc.node != newdesc.node ||
+              olddesc.node->u.i_mops->rename == NULL)
+            {
+              ret = -EXDEV;
+            }
+          else
+            {
+              /* Use the host/9p atomic replace directly. The generic VFS
+               * rename otherwise unlinks an existing destination first.
+               */
+
+              ret = olddesc.node->u.i_mops->rename(olddesc.node,
+                                                   olddesc.relpath,
+                                                   newdesc.relpath);
+              staged = ret < 0;
+            }
+
+          inode_release(newdesc.node);
+        }
+
+      RELEASE_SEARCH(&newdesc);
+      inode_release(olddesc.node);
+    }
+
+  RELEASE_SEARCH(&olddesc);
+out:
+  if (staged)
+    {
+      nx_unlink(oldpath);
+    }
+
+  encfs_erase(current, sizeof(current));
+  inode_unlock();
+  return ret;
+}
+
+/****************************************************************************
+ * Public Functions
+ ****************************************************************************/
+
+int encfs_keyfile_configure(FAR const char *directory,
+                           FAR struct encfs_key_provider_s *provider)
+{
+  struct inode_search_s desc;
+  struct stat statbuf;
+  size_t size;
+  int ret;
+
+  if (directory == NULL || directory[0] != '/' ||
+      strstr(directory, "//") != NULL ||
+      strstr(directory, "/.") != NULL)
+    {
+      return -EINVAL;
+    }
+
+  size = strlen(directory);
+  if (size == 0 || size > PATH_MAX - 32 || directory[size - 1] == '/')
+    {
+      return -ENAMETOOLONG;
+    }
+
+  inode_lock();
+  ret = keyfile_mount(directory, &desc);
+  if (ret >= 0)
+    {
+      ret = desc.node->u.i_mops->stat == NULL ? -ENOSYS :
+            desc.node->u.i_mops->stat(desc.node, desc.relpath, &statbuf);
+      if (ret >= 0 && !S_ISDIR(statbuf.st_mode))
+        {
+          ret = -ENOTDIR;
+        }
+
+      inode_release(desc.node);
+    }
+
+  if (ret >= 0)
+    {
+      memcpy(g_directory, directory, size + 1);
+      memset(provider, 0, sizeof(*provider));
+      provider->get_master = keyfile_master;
+      provider->random = keyfile_random;
+      provider->read_slot = keyfile_read;
+      provider->compare_exchange = keyfile_exchange;
+      g_fail_commit = false;
+      g_pause_commit = 0;
+    }
+
+  RELEASE_SEARCH(&desc);
+  inode_unlock();
+  return ret;
+}
+
+void encfs_keyfile_fail_commit(bool enabled)
+{
+  g_fail_commit = enabled;
+}
+
+void encfs_keyfile_pause_commit(unsigned int milliseconds)
+{
+  g_pause_commit = milliseconds;
+}
diff --git a/fs/encfs/encfs_keywrap.c b/fs/encfs/encfs_keywrap.c
new file mode 100644
index 0000000000000000000000000000000000000000..07eba2e5fa8332f10a2895642cb3a845b5abfcd0
--- /dev/null
+++ b/fs/encfs/encfs_keywrap.c
@@ -0,0 +1,406 @@
+/****************************************************************************
+ * fs/encfs/encfs_keywrap.c
+ *
+ * SPDX-License-Identifier: Apache-2.0
+ ****************************************************************************/
+
+/****************************************************************************
+ * Included Files
+ ****************************************************************************/
+
+#include <nuttx/config.h>
+
+#include <errno.h>
+#include <string.h>
+
+#include <nuttx/crypto/aes_siv.h>
+#include <nuttx/crypto/hkdf.h>
+
+#include "encfs.h"
+
+/****************************************************************************
+ * Pre-processor Definitions
+ ****************************************************************************/
+
+/* Serialized format (no native structs): magic[8], version LE32, provider
+ * key id LE32, generation LE64, reserved[8], SIV[16], sealed data keys[64].
+ * The complete header is both HKDF context and authenticated associated
+ * data. Data keys are independent of all master versions, so rewrap does
+ * not alter a live block/path cipher context or require an unmount.
+ */
+
+#define SLOT_HEADER 32
+#define SLOT_VERSION 1
+
+/****************************************************************************
+ * Private Data
+ ****************************************************************************/
+
+static const uint8_t g_magic[8] = "ENCKEY01";
+static struct encfs_key_provider_s g_provider;
+static struct encfs_keys_s g_active_keys;
+static uint8_t g_record[ENCFS_KEYSLOT_SIZE];
+static uint8_t g_pending_record[ENCFS_KEYSLOT_SIZE];
+static bool g_selected;
+static bool g_record_present;
+static bool g_valid;
+static bool g_pending;
+
+/****************************************************************************
+ * Private Functions
+ ****************************************************************************/
+
+static uint64_t read_le(FAR const uint8_t *p, unsigned int length)
+{
+  uint64_t value = 0;
+  unsigned int i;
+
+  for (i = 0; i < length; i++)
+    {
+      value |= (uint64_t)p[i] << (i * 8);
+    }
+
+  return value;
+}
+
+static void write_le(FAR uint8_t *p, uint64_t value, unsigned int length)
+{
+  unsigned int i;
+
+  for (i = 0; i < length; i++)
+    {
+      p[i] = (uint8_t)(value >> (i * 8));
+    }
+}
+
+static int slot_header(FAR const uint8_t *slot)
+{
+  unsigned int i;
+
+  if (memcmp(slot, g_magic, sizeof(g_magic)) != 0 ||
+      read_le(slot + 8, 4) != SLOT_VERSION || read_le(slot + 16, 8) == 0)
+    {
+      return -EBADMSG;
+    }
+
+  for (i = 24; i < SLOT_HEADER; i++)
+    {
+      if (slot[i] != 0)
+        {
+          return -EBADMSG;
+        }
+    }
+
+  return 0;
+}
+
+static int slot_key(FAR const uint8_t *header, FAR uint8_t *wrapping)
+{
+  static const uint8_t salt[] = "encfs-keyslot-v1";
+  uint8_t master[ENCFS_MASTER_KEY_SIZE];
+  uint32_t id = (uint32_t)read_le(header + 12, 4);
+  int ret;
+
+  memset(master, 0, sizeof(master));
+  ret = g_provider.get_master(g_provider.context, id, master);
+  if (ret == 0)
+    {
+      ret = hkdf_sha256(master, sizeof(master), salt, sizeof(salt) - 1,
+                         header, SLOT_HEADER, wrapping, AES_SIV_KEY_SIZE);
+    }
+
+  encfs_erase(master, sizeof(master));
+  return ret > 0 ? -EIO : ret;
+}
+
+static int slot_seal(uint32_t id, uint64_t generation,
+                      FAR const struct encfs_keys_s *keys,
+                      FAR uint8_t *slot)
+{
+  uint8_t wrapping[AES_SIV_KEY_SIZE];
+  int ret;
+
+  memset(wrapping, 0, sizeof(wrapping));
+  memset(slot, 0, ENCFS_KEYSLOT_SIZE);
+  memcpy(slot, g_magic, sizeof(g_magic));
+  write_le(slot + 8, SLOT_VERSION, 4);
+  write_le(slot + 12, id, 4);
+  write_le(slot + 16, generation, 8);
+  ret = slot_key(slot, wrapping);
+  if (ret == 0)
+    {
+      ret = aes_siv_encrypt(wrapping, slot, SLOT_HEADER,
+                            (FAR const uint8_t *)keys, sizeof(*keys),
+                            slot + SLOT_HEADER);
+    }
+
+  encfs_erase(wrapping, sizeof(wrapping));
+  if (ret < 0)
+    {
+      encfs_erase(slot, ENCFS_KEYSLOT_SIZE);
+    }
+
+  return ret;
+}
+
+static int slot_open(FAR const uint8_t *slot, FAR struct encfs_keys_s *keys)
+{
+  uint8_t wrapping[AES_SIV_KEY_SIZE];
+  int ret = slot_header(slot);
+
+  memset(wrapping, 0, sizeof(wrapping));
+  if (ret == 0)
+    {
+      ret = slot_key(slot, wrapping);
+    }
+
+  if (ret == 0)
+    {
+      ret = aes_siv_decrypt(wrapping, slot, SLOT_HEADER,
+                            slot + SLOT_HEADER,
+                            ENCFS_KEYSLOT_SIZE - SLOT_HEADER,
+                            (FAR uint8_t *)keys);
+    }
+
+  encfs_erase(wrapping, sizeof(wrapping));
+  if (ret < 0)
+    {
+      encfs_erase(keys, sizeof(*keys));
+    }
+
+  return ret;
+}
+
+/****************************************************************************
+ * Public Functions
+ ****************************************************************************/
+
+void encfs_keys_forget(void)
+{
+  encfs_erase(&g_active_keys, sizeof(g_active_keys));
+  encfs_erase(g_record, sizeof(g_record));
+  encfs_erase(g_pending_record, sizeof(g_pending_record));
+  g_valid = false;
+  g_record_present = false;
+  g_pending = false;
+}
+
+int encfs_key_set_provider(FAR const struct encfs_key_provider_s *provider)
+{
+  if (provider != NULL &&
+      (provider->get_master == NULL || provider->random == NULL ||
+       provider->read_slot == NULL || provider->compare_exchange == NULL))
+    {
+      return -EINVAL;
+    }
+
+  encfs_keys_forget();
+  memset(&g_provider, 0, sizeof(g_provider));
+  g_selected = provider != NULL;
+  if (provider != NULL)
+    {
+      g_provider = *provider;
+    }
+
+  return 0;
+}
+
+int encfs_keys_acquire(bool provision, FAR struct encfs_keys_s *keys,
+                       FAR enum encfs_stage_e *stage)
+{
+  uint64_t generation = 1;
+  int ret;
+
+  encfs_keys_forget();
+  memset(keys, 0, sizeof(*keys));
+  if (!g_selected)
+    {
+      return encfs_derive_keys(keys, stage);
+    }
+
+  *stage = ENCFS_STAGE_MASTER;
+  ret = g_provider.read_slot(g_provider.context, g_record);
+  if (ret == 0)
+    {
+      g_record_present = true;
+      if (slot_header(g_record) == 0)
+        {
+          generation = read_le(g_record + 16, 8);
+          if (provision && generation == UINT64_MAX)
+            {
+              ret = -EOVERFLOW;
+              goto fail;
+            }
+
+          generation += provision;
+        }
+    }
+  else if (ret != -ENOENT)
+    {
+      ret = ret > 0 ? -EIO : ret;
+      goto fail;
+    }
+  else if (!provision)
+    {
+      ret = -ENOKEY;
+      goto fail;
+    }
+
+  if (provision)
+    {
+      ret = g_provider.random(g_provider.context,
+                               (FAR uint8_t *)&g_active_keys,
+                               sizeof(g_active_keys));
+      if (ret != 0)
+        {
+          ret = ret > 0 ? -EIO : ret;
+          goto fail;
+        }
+
+      *stage = ENCFS_STAGE_DERIVE;
+      ret = slot_seal(0, generation, &g_active_keys, g_pending_record);
+      g_pending = ret == 0;
+    }
+  else
+    {
+      *stage = ENCFS_STAGE_DERIVE;
+      ret = slot_open(g_record, &g_active_keys);
+    }
+
+  if (ret < 0)
+    {
+      goto fail;
+    }
+
+  g_valid = true;
+  *keys = g_active_keys;
+  return 0;
+
+fail:
+  encfs_keys_forget();
+  return ret;
+}
+
+int encfs_keys_commit(void)
+{
+  int ret;
+
+  if (!g_pending)
+    {
+      return 0;
+    }
+
+  ret = g_provider.compare_exchange(g_provider.context,
+                                     g_record_present ? g_record : NULL,
+                                     g_pending_record);
+  if (ret != 0)
+    {
+      return ret > 0 ? -EIO : ret;
+    }
+
+  memcpy(g_record, g_pending_record, sizeof(g_record));
+  encfs_erase(g_pending_record, sizeof(g_pending_record));
+  g_record_present = true;
+  g_pending = false;
+  return 0;
+}
+
+int encfs_keys_rekey(uint32_t master_id)
+{
+  uint8_t next[ENCFS_KEYSLOT_SIZE];
+  uint64_t generation;
+  int ret;
+
+  /* Never launder a legacy directly-derived key into a wrapped volume:
+   * its old master would still compute the same live data keys forever.
+   */
+
+  if (!g_selected)
+    {
+      return -ENOTSUP;
+    }
+
+  if (!g_valid || !g_record_present || g_pending)
+    {
+      return -EINVAL;
+    }
+
+  if (master_id == (uint32_t)read_le(g_record + 12, 4))
+    {
+      return -EALREADY;
+    }
+
+  generation = read_le(g_record + 16, 8);
+  if (generation == UINT64_MAX)
+    {
+      return -EOVERFLOW;
+    }
+
+  ret = slot_seal(master_id, generation + 1, &g_active_keys, next);
+  if (ret == 0)
+    {
+      ret = g_provider.compare_exchange(g_provider.context, g_record, next);
+      if (ret == 0)
+        {
+          memcpy(g_record, next, sizeof(g_record));
+        }
+    }
+
+  encfs_erase(next, sizeof(next));
+  return ret > 0 ? -EIO : ret;
+}
+
+void encfs_keys_status(FAR struct encfs_status_s *status)
+{
+  status->key_wrapped = g_selected && g_valid && g_record_present &&
+                        !g_pending;
+  status->master_id = status->key_wrapped ?
+                      (uint32_t)read_le(g_record + 12, 4) : 0;
+  status->key_generation = status->key_wrapped ?
+                           read_le(g_record + 16, 8) : 0;
+}
+
+#ifdef CONFIG_ENCFS_TESTING
+int encfs_keys_staging_valid(FAR const uint8_t *record, size_t length)
+{
+  struct encfs_keys_s keys;
+  size_t prefix = length < sizeof(g_magic) ? length : sizeof(g_magic);
+  unsigned int i;
+  int ret;
+
+  if (length > ENCFS_KEYSLOT_SIZE ||
+      memcmp(record, g_magic, prefix) != 0)
+    {
+      return -EBADMSG;
+    }
+
+  /* A process interrupted during the write can leave an empty or prefix
+   * file. It is not authenticated; the reserved private staging name and
+   * single-writer contract authorize discarding only this bounded prefix.
+   * The committed slot has already been compared and is never removed.
+   */
+
+  for (i = 8; i < 12 && i < length; i++)
+    {
+      if (record[i] != (i == 8 ? SLOT_VERSION : 0))
+        {
+          return -EBADMSG;
+        }
+    }
+
+  if (length < ENCFS_KEYSLOT_SIZE)
+    {
+      return 0;
+    }
+
+  ret = slot_open(record, &keys);
+  if (ret == 0 &&
+      (!g_valid || memcmp(&keys, &g_active_keys, sizeof(keys)) != 0))
+    {
+      ret = -ESTALE;
+    }
+
+  encfs_erase(&keys, sizeof(keys));
+  return ret;
+}
+#endif
diff --git a/fs/encfs/encfs_manager.c b/fs/encfs/encfs_manager.c
new file mode 100644
index 0000000000000000000000000000000000000000..3121d7f7d126e768c05c588557a53606fadcf6b8
--- /dev/null
+++ b/fs/encfs/encfs_manager.c
@@ -0,0 +1,874 @@
+/****************************************************************************
+ * fs/encfs/encfs_manager.c
+ *
+ * SPDX-License-Identifier: Apache-2.0
+ *
+ ****************************************************************************/
+
+/****************************************************************************
+ * Included Files
+ ****************************************************************************/
+
+#include <nuttx/config.h>
+
+#include <sys/stat.h>
+#include <assert.h>
+#include <errno.h>
+#include <string.h>
+
+#include <nuttx/fs/encpathfs.h>
+#include <nuttx/fs/fs.h>
+#include <nuttx/mutex.h>
+
+#include "inode/inode.h"
+#include "encfs.h"
+
+/****************************************************************************
+ * Private Data
+ ****************************************************************************/
+
+static mutex_t g_lock = NXMUTEX_INITIALIZER;
+static struct encfs_status_s g_status;
+
+/* Remember identities, without retaining a reference that would prevent an
+ * ordinary umount.  The inode serial also distinguishes a new mount whose
+ * allocation reuses the old inode/private-data addresses.
+ */
+
+struct encfs_mount_s
+{
+  ino_t ino;
+  FAR const struct mountpt_operations *ops;
+  FAR void *handle;
+};
+
+static struct encfs_mount_s g_upper;
+static struct encfs_mount_s g_lower;
+
+#ifdef CONFIG_ENCFS_TESTING
+static enum encfs_test_failpoint_e g_failpoint;
+#endif
+
+/****************************************************************************
+ * Private Functions
+ ****************************************************************************/
+
+/* All state and test-provider access is serialized by g_lock.
+ * No key material is stored in status or in the mount option string.
+ */
+
+static bool encfs_has_resources(void)
+{
+  return g_status.block_registered || g_status.lower_visible ||
+         g_status.upper_mounted || g_status.path_key_staged;
+}
+
+static void encfs_update_state(void)
+{
+  if (g_status.upper_mounted)
+    {
+      g_status.state = ENCFS_READY;
+    }
+  else if (g_status.lower_visible)
+    {
+      g_status.state = ENCFS_LOWER_MOUNTED;
+    }
+  else if (g_status.block_keyed)
+    {
+      g_status.state = ENCFS_BLOCK_KEYED;
+    }
+  else if (g_status.block_registered)
+    {
+      g_status.state = ENCFS_BLOCK_REGISTERED;
+    }
+  else
+    {
+      g_status.state = ENCFS_STOPPED;
+    }
+}
+
+static void encfs_clear_error(void)
+{
+  g_status.error = 0;
+  g_status.stage = ENCFS_STAGE_NONE;
+  g_status.cleanup_error = 0;
+  g_status.cleanup_stage = ENCFS_STAGE_NONE;
+}
+
+/* Call with the inode tree locked.  A path may have disappeared, become a
+ * pseudo directory, or been reused by an unrelated mount since the last
+ * manager operation.  Never claim or unmount that replacement.
+ */
+
+static int encfs_mount_present(FAR const char *path,
+                               FAR struct encfs_mount_s *identity)
+{
+  struct inode_search_s desc;
+  FAR struct inode *inode;
+  int ret;
+
+  SETUP_SEARCH(&desc, path, true);
+  ret = inode_search(&desc);
+  if (ret >= 0)
+    {
+      inode = desc.node;
+      ret = INODE_IS_MOUNTPT(inode) && desc.relpath[0] == '\0' &&
+            inode->i_ino == identity->ino &&
+            inode->u.i_mops == identity->ops &&
+            inode->i_private == identity->handle;
+    }
+  else if (ret == -ENOENT)
+    {
+      ret = 0;
+    }
+
+  RELEASE_SEARCH(&desc);
+  return ret;
+}
+
+static int encfs_refresh_mounts(void)
+{
+  int ret;
+
+  if (g_status.upper_mounted)
+    {
+      ret = encfs_mount_present(ENCFS_UPPER_PATH, &g_upper);
+      if (ret < 0)
+        {
+          return ret;
+        }
+
+      if (ret == 0)
+        {
+          /* Successful encpathfs unbind also released its hidden lower. */
+
+          g_status.upper_mounted = false;
+          g_status.lower_visible = false;
+          memset(&g_upper, 0, sizeof(g_upper));
+          memset(&g_lower, 0, sizeof(g_lower));
+        }
+    }
+
+  if (g_status.lower_visible)
+    {
+      ret = encfs_mount_present(ENCFS_LOWER_PATH, &g_lower);
+      if (ret < 0)
+        {
+          return ret;
+        }
+
+      if (ret == 0)
+        {
+          g_status.lower_visible = false;
+          memset(&g_lower, 0, sizeof(g_lower));
+        }
+    }
+
+  encfs_update_state();
+  if (!encfs_has_resources())
+    {
+      encfs_keys_forget();
+    }
+
+  return 0;
+}
+
+/* Keep publication and identity capture atomic with respect to an external
+ * umount/mount.  Refuse aliases and occupied targets.  After nx_mount has
+ * succeeded under the tree lock, lookup cannot lose the published inode.
+ */
+
+static int encfs_mount(FAR const char *source, FAR const char *target,
+                       FAR const char *filesystem, FAR const void *data,
+                       FAR struct encfs_mount_s *identity)
+{
+  struct inode_search_s desc;
+  int ret;
+
+  inode_lock();
+  SETUP_SEARCH(&desc, target, true);
+  ret = inode_search(&desc);
+  if (ret >= 0)
+    {
+      ret = INODE_IS_PSEUDODIR(desc.node) && desc.relpath[0] == '\0' ?
+            0 : -EBUSY;
+    }
+  else if (ret == -ENOENT)
+    {
+      ret = 0;
+    }
+
+  RELEASE_SEARCH(&desc);
+  if (ret >= 0)
+    {
+      ret = nx_mount(source, target, filesystem, 0, data);
+    }
+
+  if (ret >= 0)
+    {
+      SETUP_SEARCH(&desc, target, true);
+      ret = inode_search(&desc);
+      DEBUGASSERT(ret >= 0 && INODE_IS_MOUNTPT(desc.node) &&
+                  desc.relpath[0] == '\0');
+      if (ret >= 0)
+        {
+          identity->ino = desc.node->i_ino;
+          identity->ops = desc.node->u.i_mops;
+          identity->handle = desc.node->i_private;
+        }
+
+      RELEASE_SEARCH(&desc);
+    }
+
+  inode_unlock();
+  return ret;
+}
+
+/* Reserve the upper pseudo directory before bind can take ownership of the
+ * lower mount.  With an existing target, nx_mount has no allocating/failing
+ * publication step after bind.  This avoids a VFS error path that ignores an
+ * unbind error and would otherwise strand an invisible lower mount.
+ */
+
+static int encfs_prepare_upper(void)
+{
+  struct inode_search_s desc;
+  FAR struct inode *inode;
+  int ret;
+
+  SETUP_SEARCH(&desc, ENCFS_UPPER_PATH, true);
+  inode_lock();
+  ret = inode_find(&desc);
+  if (ret >= 0)
+    {
+      ret = INODE_IS_PSEUDODIR(desc.node) && desc.relpath[0] == '\0' ?
+            0 : -EBUSY;
+      inode_release(desc.node);
+    }
+  else if (ret == -ENOENT)
+    {
+      ret = inode_reserve_path(ENCFS_UPPER_PATH, 0777, &inode);
+    }
+
+  inode_unlock();
+  RELEASE_SEARCH(&desc);
+  return ret;
+}
+
+static int encfs_inject(enum encfs_stage_e stage)
+{
+#ifdef CONFIG_ENCFS_TESTING
+  enum encfs_test_failpoint_e point = ENCFS_TEST_FAIL_NONE;
+
+  switch (stage)
+    {
+      case ENCFS_STAGE_REGISTER:
+        point = ENCFS_TEST_FAIL_REGISTER;
+        break;
+      case ENCFS_STAGE_BLOCK_KEY:
+        point = ENCFS_TEST_FAIL_KEY;
+        break;
+      case ENCFS_STAGE_LOWER_MOUNT:
+      case ENCFS_STAGE_FORMAT:
+        point = ENCFS_TEST_FAIL_LOWER;
+        break;
+      case ENCFS_STAGE_UPPER_MOUNT:
+        point = ENCFS_TEST_FAIL_UPPER;
+        break;
+      default:
+        break;
+    }
+
+  if (point != ENCFS_TEST_FAIL_NONE && g_failpoint == point)
+    {
+      g_failpoint = ENCFS_TEST_FAIL_NONE;
+      return -EIO;
+    }
+#else
+  (void)stage;
+#endif
+
+  return 0;
+}
+
+static int encfs_release_error(enum encfs_stage_e stage, int ret,
+                                bool rollback)
+{
+  if (rollback)
+    {
+      g_status.cleanup_stage = stage;
+      g_status.cleanup_error = ret;
+    }
+  else
+    {
+      g_status.stage = stage;
+      g_status.error = ret;
+    }
+
+  encfs_update_state();
+  return ret;
+}
+
+/* Release strictly in reverse ownership order.  A failed unmount must leave
+ * its dependent resources alive.  In particular, -EBUSY at /data preserves
+ * the complete running chain and the caller may retry after closing handles.
+ */
+
+static int encfs_release_locked(bool rollback)
+{
+  int ret;
+
+  ret = encfs_refresh_mounts();
+  if (ret < 0)
+    {
+      return encfs_release_error(ENCFS_STAGE_UPPER_UMOUNT, ret, rollback);
+    }
+
+  if (g_status.upper_mounted)
+    {
+      ret = nx_umount2(ENCFS_UPPER_PATH, 0);
+      if (ret < 0)
+        {
+          return encfs_release_error(ENCFS_STAGE_UPPER_UMOUNT, ret,
+                                     rollback);
+        }
+
+      /* encpathfs unbind also closes and releases the hidden FatFs mount. */
+
+      g_status.upper_mounted = false;
+      g_status.lower_visible = false;
+      memset(&g_upper, 0, sizeof(g_upper));
+      memset(&g_lower, 0, sizeof(g_lower));
+    }
+
+  if (g_status.lower_visible)
+    {
+      /* A failed metadata close may still own a temporary lower file.
+       * Retry it before releasing the key slot or unmounting its lower.
+       */
+
+      ret = encpathfs_recover();
+      if (ret < 0)
+        {
+          return encfs_release_error(ENCFS_STAGE_LOWER_UMOUNT, ret,
+                                     rollback);
+        }
+    }
+
+  if (g_status.path_key_staged)
+    {
+      ret = encpathfs_clearkey(ENCFS_KEY_SLOT);
+      if (ret < 0)
+        {
+          return encfs_release_error(ENCFS_STAGE_PATH_KEY, ret, rollback);
+        }
+
+      g_status.path_key_staged = false;
+    }
+
+  if (g_status.lower_visible)
+    {
+      ret = nx_umount2(ENCFS_LOWER_PATH, 0);
+      if (ret < 0)
+        {
+          return encfs_release_error(ENCFS_STAGE_LOWER_UMOUNT, ret,
+                                     rollback);
+        }
+
+      g_status.lower_visible = false;
+      memset(&g_lower, 0, sizeof(g_lower));
+    }
+
+  if (g_status.block_registered)
+    {
+      ret = encfs_block_unregister();
+      if (ret < 0)
+        {
+          return encfs_release_error(ENCFS_STAGE_UNREGISTER, ret, rollback);
+        }
+
+      g_status.block_registered = false;
+      g_status.block_keyed = false;
+    }
+
+  encfs_update_state();
+  if (!encfs_has_resources())
+    {
+      encfs_keys_forget();
+    }
+
+  return 0;
+}
+
+static int encfs_release(bool rollback)
+{
+  int ret;
+
+  /* Serialize the identity check and unmount itself.  Checking first and
+   * unlocking would allow another task to replace the mount in between.
+   */
+
+  inode_lock();
+  ret = encfs_release_locked(rollback);
+  inode_unlock();
+  return ret;
+}
+
+/* Start and provision share block/key acquisition, but only provision passes
+ * forceformat.  Plain start must never pass autoformat or create metadata.
+ */
+
+static int encfs_acquire(bool provision)
+{
+  struct encfs_keys_s keys;
+  int clearret;
+  int ret;
+
+  encfs_clear_error();
+  if (!provision)
+    {
+      g_status.stage = ENCFS_STAGE_PREPARE_UPPER;
+      ret = encfs_prepare_upper();
+      if (ret < 0)
+        {
+          goto fail;
+        }
+    }
+
+  g_status.stage = ENCFS_STAGE_REGISTER;
+  ret = encfs_inject(g_status.stage);
+  if (ret < 0)
+    {
+      goto fail;
+    }
+
+  ret = encfs_block_register();
+  if (ret < 0)
+    {
+      goto fail;
+    }
+
+  g_status.block_registered = true;
+  ret = encfs_keys_acquire(provision, &keys, &g_status.stage);
+  if (ret < 0)
+    {
+      goto fail;
+    }
+
+  g_status.stage = ENCFS_STAGE_BLOCK_KEY;
+  ret = encfs_inject(g_status.stage);
+  if (ret < 0)
+    {
+      goto fail;
+    }
+
+  ret = encfs_block_set_key(keys.block);
+  encfs_erase(keys.block, sizeof(keys.block));
+  if (ret < 0)
+    {
+      goto fail;
+    }
+
+  g_status.block_keyed = true;
+  g_status.stage = provision ? ENCFS_STAGE_FORMAT : ENCFS_STAGE_LOWER_MOUNT;
+  ret = encfs_inject(g_status.stage);
+  if (ret < 0)
+    {
+      goto fail;
+    }
+
+  ret = encfs_mount(ENCFS_BLOCK_DEVICE, ENCFS_LOWER_PATH, "fatfs",
+                    provision ? "forceformat" : NULL, &g_lower);
+  if (ret < 0)
+    {
+      goto fail;
+    }
+
+  g_status.lower_visible = true;
+  if (provision)
+    {
+      g_status.stage = ENCFS_STAGE_INITIALIZE;
+      ret = encpathfs_initialize(ENCFS_LOWER_PATH, keys.path,
+                                sizeof(keys.path));
+      encfs_erase(&keys, sizeof(keys));
+      if (ret < 0)
+        {
+          goto fail;
+        }
+
+      g_status.stage = ENCFS_STAGE_KEYSLOT;
+      ret = encfs_keys_commit();
+      if (ret < 0)
+        {
+          goto fail;
+        }
+
+      encfs_clear_error();
+      return encfs_release(false);
+    }
+
+  g_status.stage = ENCFS_STAGE_PATH_KEY;
+  ret = encpathfs_setkey(ENCFS_KEY_SLOT, keys.path, sizeof(keys.path));
+  encfs_erase(&keys, sizeof(keys));
+  if (ret < 0)
+    {
+      goto fail;
+    }
+
+  g_status.path_key_staged = true;
+  g_status.stage = ENCFS_STAGE_UPPER_MOUNT;
+  ret = encfs_inject(g_status.stage);
+  if (ret < 0)
+    {
+      goto fail;
+    }
+
+  ret = encfs_mount(NULL, ENCFS_UPPER_PATH, "encpathfs",
+                    "lower=" ENCFS_LOWER_PATH ",root=.p,slot=0", &g_upper);
+  if (ret >= 0)
+    {
+      g_status.upper_mounted = true;
+      g_status.lower_visible = false;
+      memset(&g_lower, 0, sizeof(g_lower));
+    }
+  else
+    {
+      /* bind consumes the lower mount on success; VFS also invokes unbind
+       * if publishing /data subsequently fails.  In that case /datap has
+       * disappeared and its resources have already been released.  Earlier
+       * bind failures leave /datap visible for our rollback.
+       */
+
+      inode_lock();
+      encfs_refresh_mounts();
+      inode_unlock();
+    }
+
+  /* bind consumes its key slot on all paths.  A failure before bind (e.g. an
+   * existing /data mount) does not, so explicitly clear that case as well.
+   * A successful mount returns -EBUSY here because its key context is
+   * active;
+   * the temporary slot has nevertheless been erased by bind.
+   */
+
+  clearret = encpathfs_clearkey(ENCFS_KEY_SLOT);
+  if (clearret >= 0 || (clearret == -EBUSY && g_status.upper_mounted))
+    {
+      g_status.path_key_staged = false;
+    }
+
+  if (ret < 0)
+    {
+      goto fail;
+    }
+
+  if (clearret < 0 && g_status.path_key_staged)
+    {
+      g_status.stage = ENCFS_STAGE_PATH_KEY;
+      ret = clearret;
+      goto fail;
+    }
+
+  encfs_clear_error();
+  encfs_update_state();
+  return 0;
+
+fail:
+  encfs_erase(&keys, sizeof(keys));
+  g_status.error = ret;
+  encfs_release(true);
+  return ret;
+}
+
+/****************************************************************************
+ * Public Functions
+ ****************************************************************************/
+
+int encfs_start(void)
+{
+  int ret = nxmutex_lock(&g_lock);
+
+  if (ret < 0)
+    {
+      return ret;
+    }
+
+  inode_lock();
+  ret = encfs_refresh_mounts();
+  if (ret >= 0)
+    {
+      if (g_status.upper_mounted)
+        {
+          ret = 0;
+        }
+      else if (encfs_has_resources())
+        {
+          ret = -EBUSY;
+        }
+      else
+        {
+          inode_unlock();
+          ret = encfs_acquire(false);
+          nxmutex_unlock(&g_lock);
+          return ret;
+        }
+    }
+
+  inode_unlock();
+  nxmutex_unlock(&g_lock);
+  return ret;
+}
+
+int encfs_stop(void)
+{
+  int ret = nxmutex_lock(&g_lock);
+
+  if (ret < 0)
+    {
+      return ret;
+    }
+
+  encfs_clear_error();
+  ret = encfs_release(false);
+  nxmutex_unlock(&g_lock);
+  return ret;
+}
+
+int encfs_provision(void)
+{
+  int ret = nxmutex_lock(&g_lock);
+
+  if (ret < 0)
+    {
+      return ret;
+    }
+
+  inode_lock();
+  ret = encfs_refresh_mounts();
+  inode_unlock();
+  if (ret >= 0)
+    {
+      ret = encfs_has_resources() ? -EBUSY : encfs_acquire(true);
+    }
+
+  nxmutex_unlock(&g_lock);
+  return ret;
+}
+
+int encfs_get_status(FAR struct encfs_status_s *status)
+{
+  int ret;
+
+  if (status == NULL)
+    {
+      return -EINVAL;
+    }
+
+  ret = nxmutex_lock(&g_lock);
+  if (ret < 0)
+    {
+      return ret;
+    }
+
+  inode_lock();
+  ret = encfs_refresh_mounts();
+  if (ret >= 0)
+    {
+      *status = g_status;
+      encfs_keys_status(status);
+    }
+
+  inode_unlock();
+  nxmutex_unlock(&g_lock);
+  return ret;
+}
+
+#ifdef CONFIG_ENCFS_KEYWRAP
+int encfs_set_key_provider(FAR const struct encfs_key_provider_s *provider)
+{
+  int ret = nxmutex_lock(&g_lock);
+
+  if (ret < 0)
+    {
+      return ret;
+    }
+
+  ret = encfs_has_resources() ? -EBUSY : encfs_key_set_provider(provider);
+  nxmutex_unlock(&g_lock);
+  return ret;
+}
+
+int encfs_rekey(uint32_t master_id)
+{
+  int ret = nxmutex_lock(&g_lock);
+
+  if (ret < 0)
+    {
+      return ret;
+    }
+
+  inode_lock();
+  ret = encfs_refresh_mounts();
+  inode_unlock();
+  if (ret >= 0)
+    {
+      encfs_clear_error();
+      g_status.stage = ENCFS_STAGE_REKEY;
+      ret = g_status.state == ENCFS_READY ?
+            encfs_keys_rekey(master_id) : -ENODEV;
+      if (ret < 0)
+        {
+          g_status.error = ret;
+        }
+      else
+        {
+          encfs_clear_error();
+        }
+    }
+
+  nxmutex_unlock(&g_lock);
+  return ret;
+}
+
+#ifdef CONFIG_ENCFS_TESTING
+int encfs_test_use_keyfiles(FAR const char *directory)
+{
+  struct encfs_key_provider_s provider;
+  int ret = nxmutex_lock(&g_lock);
+
+  if (ret < 0)
+    {
+      return ret;
+    }
+
+  if (encfs_has_resources())
+    {
+      ret = -EBUSY;
+    }
+  else
+    {
+      ret = encfs_keyfile_configure(directory, &provider);
+      if (ret >= 0)
+        {
+          ret = encfs_key_set_provider(&provider);
+        }
+    }
+
+  nxmutex_unlock(&g_lock);
+  return ret;
+}
+
+int encfs_test_keyslot_fail_commit(bool enabled)
+{
+  int ret = nxmutex_lock(&g_lock);
+
+  if (ret < 0)
+    {
+      return ret;
+    }
+
+  encfs_keyfile_fail_commit(enabled);
+  nxmutex_unlock(&g_lock);
+  return 0;
+}
+
+int encfs_test_keyslot_pause_commit(unsigned int milliseconds)
+{
+  int ret;
+
+  if (milliseconds > 60000)
+    {
+      return -EINVAL;
+    }
+
+  ret = nxmutex_lock(&g_lock);
+  if (ret < 0)
+    {
+      return ret;
+    }
+
+  encfs_keyfile_pause_commit(milliseconds);
+  nxmutex_unlock(&g_lock);
+  return 0;
+}
+#endif
+#endif
+
+#ifdef CONFIG_ENCFS_TESTING
+int encfs_test_set_master(FAR const uint8_t *key, size_t keylen)
+{
+  int ret = nxmutex_lock(&g_lock);
+
+  if (ret < 0)
+    {
+      return ret;
+    }
+
+  ret = encfs_has_resources() ? -EBUSY :
+        encfs_key_set_test_master(key, keylen);
+#ifdef CONFIG_ENCFS_KEYWRAP
+  if (ret >= 0)
+    {
+      encfs_key_set_provider(NULL);
+    }
+
+#endif
+  nxmutex_unlock(&g_lock);
+  return ret;
+}
+
+int encfs_test_use_board_key(void)
+{
+  int ret = nxmutex_lock(&g_lock);
+
+  if (ret < 0)
+    {
+      return ret;
+    }
+
+  if (encfs_has_resources())
+    {
+      ret = -EBUSY;
+    }
+  else
+    {
+      encfs_key_use_board();
+#ifdef CONFIG_ENCFS_KEYWRAP
+      encfs_key_set_provider(NULL);
+#endif
+      ret = 0;
+    }
+
+  nxmutex_unlock(&g_lock);
+  return ret;
+}
+
+int encfs_test_set_failpoint(enum encfs_test_failpoint_e failpoint)
+{
+  int ret;
+
+  if (failpoint < ENCFS_TEST_FAIL_NONE || failpoint > ENCFS_TEST_FAIL_UPPER)
+    {
+      return -EINVAL;
+    }
+
+  ret = nxmutex_lock(&g_lock);
+  if (ret < 0)
+    {
+      return ret;
+    }
+
+  if (encfs_has_resources())
+    {
+      ret = -EBUSY;
+    }
+  else
+    {
+      g_failpoint = failpoint;
+      ret = 0;
+    }
+
+  nxmutex_unlock(&g_lock);
+  return ret;
+}
+#endif
diff --git a/fs/encfs/tests/test_keywrap.py b/fs/encfs/tests/test_keywrap.py
