index 0000000000000000000000000000000000000000..d25bc60dcbb3e53055e17ab9fe46525144cdb557
--- /dev/null
+++ b/fs/encpathfs/encpathfs_path.c
@@ -0,0 +1,170 @@
+/****************************************************************************
+ * fs/encpathfs/encpathfs_path.c
+ *
+ * SPDX-License-Identifier: Apache-2.0
+ ****************************************************************************/
+
+#include <nuttx/config.h>
+#include <errno.h>
+#include <string.h>
+#include "encpathfs.h"
+
+int encpathfs_path(FAR struct encpathfs_mount_s *mount,
+                  FAR const char *relative, FAR char **physical,
+                  FAR char **logical)
+{
+  FAR char *path;
+  FAR char *normal;
+  FAR const char *start;
+  FAR const char *p;
+  FAR char *last;
+  char component[ENCPATHFS_NAME_MAX + 1];
+  char encoded[ENCPATHFS_ENCODED_MAX + 1];
+  struct stat st;
+  size_t used = sizeof(ENCPATHFS_ROOT) - 1;
+  size_t nused = 0;
+  size_t length;
+  size_t elength;
+  int ret = 0;
+
+  if (relative == NULL || physical == NULL)
+    {
+      return -EINVAL;
+    }
+
+  if (strnlen(relative, PATH_MAX) == PATH_MAX)
+    {
+      return -ENAMETOOLONG;
+    }
+
+  path = fs_heap_malloc(PATH_MAX);
+  normal = fs_heap_malloc(PATH_MAX);
+  if (path == NULL || normal == NULL)
+    {
+      ret = -ENOMEM;
+      goto out;
+    }
+
+  memcpy(path, ENCPATHFS_ROOT, used + 1);
+  normal[0] = '\0';
+  p = relative;
+  while (*p != '\0')
+    {
+      if (*p == '/')
+        {
+          p++;
+          continue;
+        }
+
+      start = p;
+      while (*p != '\0' && *p != '/')
+        {
+          p++;
+        }
+
+      length = p - start;
+      if ((length == 1 && start[0] == '.') ||
+          (length == 2 && start[0] == '.' && start[1] == '.'))
+        {
+          /* Verify the traversed directory before removing a component:
+           * missing/../name must not bypass a missing intermediate path.
+           */
+
+          ret = mount->lower->u.i_mops->stat(mount->lower, path, &st);
+          if (ret < 0)
+            {
+              goto out;
+            }
+
+          if (!S_ISDIR(st.st_mode))
+            {
+              ret = -ENOTDIR;
+              goto out;
+            }
+
+          if (length == 2)
+            {
+              if (nused == 0)
+                {
+                  ret = -EPERM;
+                  goto out;
+                }
+
+              last = strrchr(path, '/');
+              *last = '\0';
+              used = last - path;
+              last = strrchr(normal, '/');
+              nused = last == NULL ? 0 : (size_t)(last - normal);
+              normal[nused] = '\0';
+            }
+
+          continue;
+        }
+
+      if (length > ENCPATHFS_NAME_MAX)
+        {
+          ret = -ENAMETOOLONG;
+          goto out;
+        }
+
+      memcpy(component, start, length);
+      component[length] = '\0';
+      ret = encpathfs_encode_name(mount->key, component,
+                                  encoded, sizeof(encoded));
+      if (ret < 0)
+        {
+          goto out;
+        }
+
+      elength = strlen(encoded);
+      if (used + 1 + elength >= PATH_MAX ||
+          nused + (nused != 0) + length >= PATH_MAX)
+        {
+          ret = -ENAMETOOLONG;
+          goto out;
+        }
+
+      path[used++] = '/';
+      memcpy(path + used, encoded, elength + 1);
+      used += elength;
+      if (nused != 0)
+        {
+          normal[nused++] = '/';
+        }
+
+      memcpy(normal + nused, component, length + 1);
+      nused += length;
+    }
+
+  /* A trailing slash imposes directory semantics even for file operations. */
+
+  length = strlen(relative);
+  if (length > 0 && relative[length - 1] == '/' && nused != 0)
+    {
+      ret = mount->lower->u.i_mops->stat(mount->lower, path, &st);
+      if (ret < 0)
+        {
+          goto out;
+        }
+
+      if (!S_ISDIR(st.st_mode))
+        {
+          ret = -ENOTDIR;
+          goto out;
+        }
+    }
+
+  *physical = path;
+  path = NULL;
+  if (logical != NULL)
+    {
+      *logical = normal;
+      normal = NULL;
+    }
+
+out:
+  encpathfs_erase(component, sizeof(component));
+  fs_heap_free(path);
+  fs_heap_free(normal);
+  return ret;
+}
diff --git a/fs/encpathfs/tests/test_utf8.py b/fs/encpathfs/tests/test_utf8.py
new file mode 100644
index 0000000000000000000000000000000000000000..979adea062959347e0c200d26ff13f4975c1934f
--- /dev/null
+++ b/fs/encpathfs/tests/test_utf8.py
@@ -0,0 +1,188 @@
+#!/usr/bin/env python3
+"""Compile the real component codec and check it against Python's UTF-8 codec.
+
+Only platform declarations are stubbed; AES, CMAC, AES-SIV, Base32 and name
+validation are the repository implementations.  No emulator is required.
+"""
+
+import argparse
+import base64
+import ctypes
+import errno
+import json
+import pathlib
+import random
+import shutil
+import subprocess
+import tempfile
+
+
+def expected(raw):
+    try:
+        raw.decode("utf-8", errors="strict")
+    except UnicodeDecodeError:
+        return False
+    return (0 < len(raw) <= 128 and raw not in (b".", b"..") and
+            all(byte >= 0x20 and byte not in (0x2f, 0x7f) for byte in raw))
+
+
+def main():
+    parser = argparse.ArgumentParser(description=__doc__)
+    parser.add_argument("--report", type=pathlib.Path)
+    parser.add_argument("--legacy-codec", type=pathlib.Path,
+                        help="optionally compare actual previous ASCII codec source")
+    args = parser.parse_args()
+    root = pathlib.Path(__file__).resolve().parents[3]
+    counts = {"unicode_scalars": 0, "two_byte_inputs": 0,
+              "generated_invalid_and_mixed": 0, "codec_roundtrips": 0,
+              "authenticated_invalid_plaintexts": 0,
+              "legacy_ascii_ciphertexts": 0}
+
+    with tempfile.TemporaryDirectory(prefix="encpathfs-utf8-") as tmp:
+        tmp = pathlib.Path(tmp)
+        include = tmp / "include"
+        for relative in ("nuttx/crypto/aes_siv.h", "nuttx/fs/encpathfs.h",
+                         "crypto/aes.h", "crypto/cmac.h"):
+            target = include / relative
+            target.parent.mkdir(parents=True, exist_ok=True)
+            shutil.copyfile(root / "include" / relative, target)
+        (include / "nuttx/config.h").write_text("")
+        (include / "nuttx/compiler.h").write_text("#define FAR\n")
+        source = tmp / "wrapper.c"
+        source.write_text(
+            '#include "' + str(root / "fs/encpathfs/encpathfs_codec.c") +
+            '"\nint test_valid_name(const char *p, size_t n)\n'
+            '{ return encpathfs_valid_name(p, n); }\n')
+        library = tmp / "codec.so"
+        subprocess.run([
+            "cc", "-shared", "-fPIC", "-O2", "-g", "-Wall", "-Wextra",
+            "-Werror", "-fsanitize=undefined", "-fno-sanitize-recover=all",
+            "-include", "stdint.h", "-include", str(include / "nuttx/compiler.h"),
+            "-I", str(include), str(source), str(root / "crypto/aes.c"),
+            str(root / "crypto/cmac.c"), str(root / "crypto/aes_siv.c"),
+            "-o", str(library)], check=True)
+        lib = ctypes.CDLL(str(library))
+        valid = lib.test_valid_name
+        valid.argtypes = (ctypes.c_char_p, ctypes.c_size_t)
+        valid.restype = ctypes.c_int
+
+        def check(raw, group):
+            assert bool(valid(raw, len(raw))) == expected(raw), raw.hex()
+            counts[group] += 1
+
+        # Exhaust every Unicode scalar and every possible two-byte buffer.
+        # Python's strict decoder is independent of the C validator.
+        for scalar in range(0x110000):
+            if not 0xd800 <= scalar <= 0xdfff:
+                check(chr(scalar).encode("utf-8"), "unicode_scalars")
+        for first in range(256):
+            for second in range(256):
+                check(bytes((first, second)), "two_byte_inputs")
+
+        invalid = [b"", b".", b"..", b"a/b", b"a\x00b", b"\xc0\x80",
+                   b"\xc0\xaf", b"\xe0\x80\xaf", b"\xf0\x80\x80\xaf",
+                   b"\xed\xa0\x80", b"\xed\xbf\xbf", b"\xf4\x90\x80\x80",
+                   b"\xf8\x88\x80\x80\x80", b"\xfc\x84\x80\x80\x80\x80",
+                   b"\xef\xbb", b"\xf0\x9f\x94", b"a" * 129]
+        rng = random.Random(3629)
+        for raw in invalid:
+            check(raw, "generated_invalid_and_mixed")
+        for unused in range(50000):
+            raw = bytes(rng.randrange(256) for item in range(rng.randrange(140)))
+            check(raw, "generated_invalid_and_mixed")
+        for unused in range(10000):
+            scalar = rng.randrange(0x110000)
+            if 0xd800 <= scalar <= 0xdfff:
+                continue
+            sample = bytearray(("中" + chr(scalar) + "文").encode("utf-8"))
+            sample[rng.randrange(len(sample))] = rng.randrange(256)
+            check(bytes(sample), "generated_invalid_and_mixed")
+
+        key = bytes(range(32))
+        encode = lib.encpathfs_encode_name
+        decode = lib.encpathfs_decode_name
+        seal = lib.aes_siv_encrypt
+        encode.argtypes = (ctypes.c_char_p, ctypes.c_char_p, ctypes.c_void_p,
+                           ctypes.c_size_t)
+        decode.argtypes = encode.argtypes
+        seal.argtypes = (ctypes.c_char_p, ctypes.c_char_p, ctypes.c_size_t,
+                         ctypes.c_char_p, ctypes.c_size_t, ctypes.c_void_p)
+        names = [b"secret.txt", b"ASCII 0123456789 !#$%&'()+,-.;=@[]^_`{}~",
+                 b"a" * 128, "中文文件.txt".encode(), "🔐-café".encode(),
+                 "é".encode(), "e\u0301".encode(), "中".encode() * 42 + b"ab",
+                 "🔐".encode() * 32]
+        names += [bytes((value,)) for value in range(0x20, 0x7f)
+                  if value not in (ord("/"), ord("."))]
+        fixtures = {}
+        for raw in names:
+            out = ctypes.create_string_buffer(235)
+            plain = ctypes.create_string_buffer(129)
+            assert encode(key, raw, out, len(out)) == 0, raw
+            assert out.value.startswith(b"E1_")
+            assert decode(key, out.value, plain, len(plain)) == 0
+            assert plain.value == raw
+            # Capacity includes the NUL, even for multi-byte names.
+            small = ctypes.create_string_buffer(len(raw))
+            assert decode(key, out.value, small, len(small)) == -errno.ENAMETOOLONG
+            assert small.raw[0] == 0
+            if raw == b"secret.txt":
+                assert out.value == b"E1_A1CP2UT8PNK4I9HJ7UQILMT155DE81L20K7VS8F3VO"
+                fixtures[raw.decode()] = out.value.decode()
+            counts["codec_roundtrips"] += 1
+
+        if args.legacy_codec:
+            legacy_library = tmp / "legacy.so"
+            subprocess.run([
+                "cc", "-shared", "-fPIC", "-O2", "-Wall", "-Wextra", "-Werror",
+                "-include", "stdint.h", "-include", str(include / "nuttx/compiler.h"),
+                "-I", str(include), str(args.legacy_codec.resolve()),
+                str(root / "crypto/aes.c"), str(root / "crypto/cmac.c"),
+                str(root / "crypto/aes_siv.c"), "-o", str(legacy_library)], check=True)
+            legacy = ctypes.CDLL(str(legacy_library))
+            legacy_encode = legacy.encpathfs_encode_name
+            legacy_encode.argtypes = encode.argtypes
+            samples = [raw for raw in names if raw.isascii()]
+            for length in range(1, 129):
+                sample = bytes(rng.choice([byte for byte in range(0x20, 0x7f)
+                                           if byte != ord("/")])
+                               for unused in range(length))
+                if sample in (b".", b".."):
+                    sample = b"a" * length
+                samples.append(sample)
+            for raw in samples:
+                previous = ctypes.create_string_buffer(235)
+                current = ctypes.create_string_buffer(235)
+                assert legacy_encode(key, raw, previous, len(previous)) == 0
+                assert encode(key, raw, current, len(current)) == 0
+                assert previous.value == current.value, raw
+                counts["legacy_ascii_ciphertexts"] += 1
+
+        # These inputs have valid SIV tags, so failure must arise from the
+        # plaintext component policy, rather than authentication rejection.
+        ad = b"encpathfs:name:v1"
+        for raw in invalid + [b"a\x1fb", b"a\x7fb"]:
+            if len(raw) > 128 or not raw:
+                continue
+            sealed = ctypes.create_string_buffer(len(raw) + 16)
+            assert seal(key, ad, len(ad), raw, len(raw), sealed) == 0
+            physical = b"E1_" + base64.b32hexencode(sealed.raw).rstrip(b"=")
+            out = ctypes.create_string_buffer(b"do-not-expose", 129)
+            assert decode(key, physical, out, len(out)) == -errno.EBADMSG, raw.hex()
+            assert out.value == b""
+            counts["authenticated_invalid_plaintexts"] += 1
+
+        # An authenticated NUL is invalid; a public C-string parameter ends
+        # at its first NUL, as for every POSIX pathname interface.
+        report = {"status": "passed", "counts": counts,
+                  "checks": sum(counts.values()), "legacy_ascii_fixture": fixtures,
+                  "oracle": "Python strict UTF-8 decoder; Unicode scalar enumeration",
+                  "sanitizer": "undefined behavior; fatal on first diagnostic",
+                  "limits": "128 bytes; no normalization or case folding"}
+        if args.report:
+            args.report.parent.mkdir(parents=True, exist_ok=True)
+            args.report.write_text(json.dumps(report, indent=2) + "\n")
+        print(json.dumps(report, indent=2))
+
+
+if __name__ == "__main__":
+    main()
